<!doctype html>
<html lang="ru"><head><meta charset="utf-8">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap">
<style>
/* Токены из дизайн-системы BIG Life (tokens/colors.css, typography.css). */
@font-face{font-family:"TT Firs Neue";src:url("{{ assets }}/TT_Firs_Neue_Trial_Var_Roman.ttf") format("truetype-variations");font-weight:100 900}
:root{--navy:#28348a;--sky:#009fe3;--green:#88c947;--orange:#ff954c;--periwinkle:#556bb8;--body:#2b3350;--muted:#808aa3;--subtle:#f5f7fb;
--display:"TT Firs Neue","Montserrat",sans-serif;--text:"Montserrat",sans-serif;--accent:var(--{{ accent }})}
*{box-sizing:border-box}body{margin:0;background:#dfe6f4;font-family:var(--text)}
.f{width:1080px;height:1350px;position:relative;overflow:hidden;padding:90px;display:flex;flex-direction:column}
.navy{background:var(--navy);color:#fff}.light{background:var(--subtle);color:var(--navy)}.acc{background:var(--accent);color:#fff}
.glow{position:absolute;width:760px;height:760px;border-radius:50%;right:-240px;top:-260px;background:radial-gradient(circle,color-mix(in srgb,var(--accent) 60%,transparent),transparent 62%)}
.glow.b{left:-300px;right:auto;top:auto;bottom:-320px;background:radial-gradient(circle,rgba(166,229,236,.3),transparent 62%)}
.z{position:relative;z-index:2}
.top{display:flex;justify-content:space-between;align-items:center}
.logo{height:44px;filter:brightness(0) invert(1)}
.eyebrow{font-size:22px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
.pill{display:inline-block;font-size:22px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;padding:12px 22px;border-radius:999px;background:var(--accent);color:#fff}
h1{font-family:var(--display);font-weight:800;font-size:100px;line-height:.98;letter-spacing:-.02em;margin:28px 0 0}
h2{font-family:var(--display);font-weight:800;font-size:66px;line-height:1.02;letter-spacing:-.02em;margin:0 0 26px}
p{font-size:30px;line-height:1.5;margin:0}
.num{font-family:var(--display);font-size:64px;font-weight:800;color:var(--accent);line-height:1}
.head{display:flex;align-items:baseline;gap:20px;margin-bottom:12px}
.photo{flex:1;border-radius:28px;overflow:hidden;margin-top:44px;min-height:0}
.photo img{width:100%;height:100%;object-fit:cover;display:block}
.page{position:absolute;right:90px;bottom:64px;font-size:22px;font-weight:700;opacity:.55;z-index:3}
.big{font-family:var(--display);font-weight:800;letter-spacing:-.03em;line-height:.95;margin:26px 0 40px}
.card{background:#fff;border-radius:28px;padding:30px 36px;font-size:34px;font-weight:600;color:var(--navy);box-shadow:0 8px 24px rgba(40,52,138,.08);margin-bottom:22px}
.card small{display:block;font-size:22px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.step{display:flex;gap:26px;align-items:flex-start;margin-bottom:30px}
.step b{flex:0 0 64px;height:64px;border-radius:50%;background:#fff;color:var(--accent);font-family:var(--display);font-size:32px;display:flex;align-items:center;justify-content:center}
.step span{font-size:34px;font-weight:600;line-height:1.35;padding-top:8px}
.btn{display:inline-block;font-size:28px;font-weight:800;padding:22px 42px;border-radius:999px;background:var(--sky);color:#fff}
.src{font-size:20px;line-height:1.45;opacity:.6;margin-top:30px}
.ill{border-radius:28px;overflow:hidden;background:#fff}
.ill img{width:100%;height:100%;object-fit:cover;display:block}
.cover-ill{position:absolute;right:-50px;bottom:-90px;width:470px;height:627px;transform:rotate(-4deg);border-radius:36px;box-shadow:0 30px 60px rgba(0,0,0,.35);z-index:1;overflow:hidden;border:10px solid #fff}
.cover-ill img{width:100%;height:100%;object-fit:cover}
/* Коллаж: фото в духе вырезки из журнала — ч/б с цветным тоном, растр, скотч, наклейка с подписью */
.collage{position:relative;width:640px;height:720px;margin:10px auto 0;flex:0 0 auto}
.collage .paper{position:absolute;inset:0;background:var(--accent);transform:rotate(5deg);border-radius:6px;opacity:.9}
.collage .frame{position:absolute;inset:18px 24px 30px 18px;background:#fff;padding:18px;transform:rotate(-3deg);box-shadow:0 18px 40px rgba(20,26,46,.25)}
.collage .photo-in{position:relative;width:100%;height:100%;overflow:hidden;background:#ccc}
.collage .photo-in img{width:100%;height:100%;object-fit:cover;object-position:50% 18%;filter:grayscale(1) contrast(1.15) brightness(1.05);display:block}
.collage .photo-in::after{content:"";position:absolute;inset:0;background:#7fb8ff;mix-blend-mode:multiply;opacity:.55}
.collage .photo-in::before{content:"";position:absolute;inset:0;z-index:2;opacity:.18;mix-blend-mode:multiply;background-image:radial-gradient(#000 1.2px,transparent 1.6px);background-size:7px 7px}
.collage .tape{position:absolute;width:190px;height:50px;background:rgba(255,246,214,.82);top:6px;left:-40px;transform:rotate(-38deg);z-index:3;box-shadow:0 2px 6px rgba(0,0,0,.12)}
.collage .tag{position:absolute;left:-10px;bottom:-24px;z-index:4;background:var(--navy);color:#fff;padding:18px 26px;border-radius:14px;transform:rotate(-2deg);max-width:560px}
.collage .tag b{display:block;font-family:var(--display);font-size:38px;line-height:1.05}
.collage .tag span{font-size:22px;font-weight:600;opacity:.85}
.collage .mono{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-family:var(--display);font-size:220px;font-weight:800;color:#fff;background:var(--navy)}
.credit{font-size:16px;opacity:.55;margin-top:44px}
.bgphoto{position:absolute;inset:0;z-index:0}
.bgphoto img{width:100%;height:100%;object-fit:cover}
.bgphoto::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(40,52,138,.55) 0%,rgba(40,52,138,.15) 30%,rgba(40,52,138,.55) 60%,rgba(28,36,100,.95) 100%)}
.evphoto{height:860px;border-radius:28px;overflow:hidden;margin:-10px -10px 44px;box-shadow:0 14px 40px rgba(40,52,138,.18);flex:0 0 auto}
.evphoto img{width:100%;height:100%;object-fit:cover;display:block}
</style></head><body>
{% set total = slides|length %}
{% for s in slides %}{% set n = loop.index %}
{% if s.type == 'cover' %}
<section class="f navy" id="s{{ n }}" style="justify-content:space-between">
  {% if dphotos.get(s.photo_ref) %}<div class="bgphoto"><img src="{{ dphotos[s.photo_ref] }}" alt=""></div>
  {% else %}<div class="glow"></div><div class="glow b"></div>{% endif %}
  {% if ills.get(s.illustration_id) %}<div class="cover-ill"><img src="{{ ills[s.illustration_id] }}" alt=""></div>{% endif %}
  <div class="z top"><img class="logo" src="{{ assets }}/logo-horizontal.png" alt="BIG Life"><span class="eyebrow" style="color:var(--accent)">{{ rubric_title }}</span></div>
  <div class="z">
    {% if s.eyebrow %}<span class="pill">{{ s.eyebrow }}</span>{% endif %}
    <h1 style="font-size:{{ 112 if s.title|length < 45 else (100 if s.title|length < 70 else 84) }}px{% if ills.get(s.illustration_id) %};max-width:10ch;font-size:{{ 96 if s.title|length < 45 else 84 }}px{% endif %}">{{ s.title }}</h1>
    {% if s.text %}<p style="margin-top:30px;opacity:.85;max-width:28ch">{{ s.text }}</p>{% endif %}
  </div>
  <div class="z" style="font-size:28px;font-weight:700;opacity:.85">Листайте →</div>
</section>
{% elif s.type == 'insight' %}
<section class="f light" id="s{{ n }}">
  <div class="head"><span class="num">{{ '%02d' % (n - 1) }}</span><span class="eyebrow" style="color:var(--muted)">{{ s.eyebrow }}</span></div>
  <h2>{{ s.title }}</h2>
  {% if s.text %}<p style="color:var(--body);max-width:31ch">{{ s.text }}</p>{% endif %}
  {% if ills.get(s.illustration_id) %}<div class="photo ill"><img src="{{ ills[s.illustration_id] }}" alt=""></div>
  {% elif photo %}<div class="photo"><img src="{{ photo }}" alt=""></div>{% endif %}
  <span class="page" style="color:var(--navy)">{{ n }}/{{ total }}</span>
</section>
{% elif s.type == 'person' %}{% set pic = pictures.get(s.person, {}) %}{% set ref = people.get(s.person, {}) %}
<section class="f light" id="s{{ n }}">
  <div class="head"><span class="num">{{ '%02d' % (n - 1) }}</span><span class="eyebrow" style="color:var(--muted)">{{ s.eyebrow }}</span></div>
  <div class="collage">
    <div class="paper"></div>
    <div class="frame"><div class="tape"></div><div class="photo-in">
      {% if pic.uri %}<img src="{{ pic.uri }}" alt="">{% else %}<div class="mono">{{ (ref.name_ru or s.person or '?')[:1] }}</div>{% endif %}
    </div></div>
    <div class="tag"><b>{{ ref.name_ru or s.person }}</b>{% if ref.role_ru %}<span>{{ ref.role_ru }}</span>{% endif %}</div>
  </div>
  <h2 style="margin-top:70px;font-size:56px">{{ s.title }}</h2>
  {% if s.text %}<p style="color:var(--body);max-width:32ch;font-size:28px">{{ s.text }}</p>{% endif %}
  {% if pic.credit %}<div class="credit" style="margin-top:auto">{{ pic.credit }}</div>{% endif %}
  <span class="page" style="color:var(--navy)">{{ n }}/{{ total }}</span>
</section>
{% elif s.type == 'event' %}
<section class="f light" id="s{{ n }}">
  {% if dphotos.get(s.photo_ref) %}<div class="evphoto"><img src="{{ dphotos[s.photo_ref] }}" alt=""></div>{% endif %}
  <span class="eyebrow" style="color:var(--accent);margin-bottom:16px">{{ s.eyebrow }}</span>
  <h2 style="font-size:58px">{{ s.title }}</h2>
  {% if s.text %}<p style="color:var(--body);max-width:32ch;font-size:28px">{{ s.text }}</p>{% endif %}
  <span class="page" style="color:var(--navy)">{{ n }}/{{ total }}</span>
</section>
{% elif s.type in ('statement', 'stat') %}
<section class="f acc" id="s{{ n }}" style="justify-content:center">
  <span class="eyebrow" style="opacity:.9">{{ '%02d' % (n - 1) }} · {{ s.eyebrow }}</span>
  {% if s.type == 'stat' %}
  <div class="big" style="font-size:{{ 230 if s.title|length < 8 else (160 if s.title|length < 14 else 110) }}px">{{ s.title }}</div>
  {% else %}
  <div class="big" style="font-size:{{ 118 if s.title|length < 50 else (96 if s.title|length < 80 else 80) }}px">{{ s.title }}</div>
  {% endif %}
  {% if s.text %}<p style="font-size:36px;font-weight:600;line-height:1.35;max-width:24ch">{{ s.text }}</p>{% endif %}
  <span class="page">{{ n }}/{{ total }}</span>
</section>
{% elif s.type == 'list' %}
<section class="f light" id="s{{ n }}">
  <div class="head"><span class="num">{{ '%02d' % (n - 1) }}</span><span class="eyebrow" style="color:var(--muted)">{{ s.eyebrow }}</span></div>
  <h2 style="margin-bottom:20px">{{ s.title }}</h2>
  {% if s.text %}<p style="color:var(--body);margin-bottom:40px;max-width:31ch">{{ s.text }}</p>{% endif %}
  {% for it in s['items'] %}<div class="card">{% if s.item_labels[loop.index0] %}<small>{{ s.item_labels[loop.index0] }}</small>{% endif %}{{ it }}</div>{% endfor %}
  <span class="page" style="color:var(--navy)">{{ n }}/{{ total }}</span>
</section>
{% elif s.type == 'steps' %}
<section class="f acc" id="s{{ n }}">
  <span class="eyebrow" style="opacity:.9">{{ '%02d' % (n - 1) }} · {{ s.eyebrow }}</span>
  <h2 style="color:#fff;margin-top:24px">{{ s.title }}</h2>
  {% if s.text %}<p style="font-weight:500;margin-bottom:46px;max-width:31ch">{{ s.text }}</p>{% endif %}
  {% for it in s['items'] %}<div class="step"><b>{{ loop.index }}</b><span>{{ it }}</span></div>{% endfor %}
  <span class="page">{{ n }}/{{ total }}</span>
</section>
{% elif s.type == 'question' %}
<section class="f light" id="s{{ n }}" style="justify-content:center">
  <span class="eyebrow" style="color:var(--muted)">{{ s.eyebrow or 'Вопрос к вам' }}</span>
  <div class="big" style="color:var(--navy);font-size:{{ 96 if s.title|length < 60 else 78 }}px">{{ s.title }}</div>
  {% if s.text %}<p style="color:var(--body);max-width:30ch">{{ s.text }}</p>{% endif %}
  {% for it in s['items'] %}<div class="card" style="margin-top:18px;margin-bottom:0">{{ it }}</div>{% endfor %}
  <span class="page" style="color:var(--navy)">{{ n }}/{{ total }}</span>
</section>
{% else %}
<section class="f navy" id="s{{ n }}" style="justify-content:space-between">
  <div class="glow"></div>
  <img class="z logo" src="{{ assets }}/logo-horizontal.png" alt="BIG Life" style="align-self:flex-start">
  <div class="z">
    <h2 style="font-size:{{ 84 if s.title|length < 70 else 68 }}px;color:#fff">{{ s.title }}</h2>
    {% if s.text %}<p style="opacity:.85;max-width:27ch">{{ s.text }}</p>{% endif %}
  </div>
  <div class="z">
    <span class="btn">{{ s.eyebrow or 'Активности двора — в BIG App' }}</span>
    <div class="src">Источник: {{ source_line }}</div>
  </div>
</section>
{% endif %}
{% endfor %}
</body></html>
