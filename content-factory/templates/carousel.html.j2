<!doctype html>
<html lang="ru"><head><meta charset="utf-8">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap">
<style>
/* Карусель BIG Life, ревизия 2 (25.11):
   зоны «шапка / контент / подвал», шкала из 6 размеров, ритм фонов «светлый ↔ цвет», navy только на краях. */
@font-face{font-family:"TT Firs Neue";src:url("{{ assets }}/TT_Firs_Neue_Trial_Var_Roman.ttf") format("truetype-variations");font-weight:100 900}
:root{
  --navy:#28348a;--sky:#009fe3;--green:#88c947;--orange:#ff954c;--periwinkle:#556bb8;
  --ink:#2b3350;--muted:#808aa3;--light:#f5f7fb;--line:#e3e8f1;
  --accent:var(--{{ accent }});--accent2:var(--{{ accent2 }});
  --display:"TT Firs Neue","Montserrat",sans-serif;--text:"Montserrat",sans-serif;
  /* шкала: обложка 100, вывод 84, заголовок 64, цифра 220, текст 34, метка 24, мелкий 20 */
  --fs-cover:100px;--fs-h1:84px;--fs-h2:64px;--fs-stat:220px;--fs-body:34px;--fs-label:24px;--fs-small:20px;
  --pad:90px;--r:28px
}
*{box-sizing:border-box}body{margin:0;background:#cfd6e6;font-family:var(--text)}
.f{width:1080px;height:1350px;position:relative;overflow:hidden;padding:84px var(--pad) 0;display:flex;flex-direction:column}
.bg-navy{background:var(--navy);color:#fff}.bg-light{background:var(--light);color:var(--navy)}
.bg-accent{background:var(--accent);color:#fff}.bg-accent2{background:var(--accent2);color:#fff}
.glow{position:absolute;width:760px;height:760px;border-radius:50%;right:-260px;top:-300px;background:radial-gradient(circle,color-mix(in srgb,var(--accent) 55%,transparent),transparent 62%);pointer-events:none}

/* шапка: одна система навигации — «01 · ЭТИКЕТКА» */
.hd{display:flex;align-items:center;gap:16px;min-height:52px;flex:0 0 auto;position:relative;z-index:2}
.tag{display:inline-flex;align-items:center;gap:12px;font-size:var(--fs-label);font-weight:800;letter-spacing:.14em;text-transform:uppercase;padding:12px 22px;border-radius:999px}
.bg-light .tag{background:#fff;color:var(--navy);box-shadow:0 4px 14px rgba(40,52,138,.08)}
.bg-light .tag b{color:var(--accent)}
.bg-accent .tag,.bg-accent2 .tag,.bg-navy .tag{background:rgba(255,255,255,.18);color:#fff}
.logo{height:40px}
.bg-navy .logo,.bg-accent .logo,.bg-accent2 .logo{filter:brightness(0) invert(1)}

/* контент: всё между шапкой и подвалом; текстовые слайды центрируются по вертикали */
.ct{flex:1 1 auto;display:flex;flex-direction:column;min-height:0;padding:40px 0 36px;position:relative;z-index:1}
.ct.mid{justify-content:center}
h1,h2,.big{font-family:var(--display);font-weight:800;letter-spacing:-.02em;margin:0}
h1{font-size:var(--fs-cover);line-height:.98}
h2{font-size:var(--fs-h2);line-height:1.04}
.big{font-size:var(--fs-h1);line-height:1.0}
.statnum{font-family:var(--display);font-weight:800;font-size:var(--fs-stat);line-height:.9;letter-spacing:-.03em}
p{font-size:var(--fs-body);line-height:1.45;margin:28px 0 0;max-width:30ch}
.bg-light p{color:var(--ink)}
p.lead{font-size:40px;line-height:1.42;font-weight:500;max-width:34ch}
.ct.mid p{max-width:36ch}
canvas.viz{display:block;width:100%;flex:1 1 0;min-height:420px;margin-top:20px}
.bg-accent p,.bg-accent2 p,.bg-navy p{color:rgba(255,255,255,.92)}

/* подвал: логотип + прогресс карусели */
.ft{flex:0 0 96px;display:flex;align-items:center;justify-content:space-between;border-top:2px solid rgba(128,138,163,.18);position:relative;z-index:2}
.bg-accent .ft,.bg-accent2 .ft,.bg-navy .ft{border-top-color:rgba(255,255,255,.22)}
.prog{display:flex;gap:8px}
.prog i{display:block;width:22px;height:6px;border-radius:3px;background:currentColor;opacity:.22}
.prog i.on{opacity:1;width:44px}

/* медиа: единое скругление и тень, высота — сколько останется */
.media{flex:1 1 0;min-height:380px;border-radius:var(--r);overflow:hidden;margin-top:40px;position:relative;box-shadow:0 14px 40px rgba(40,52,138,.14)}
.media img{width:100%;height:100%;object-fit:cover;object-position:50% 40%;display:block}
.ill{background:#fff}
.citytag{position:absolute;left:24px;top:24px;z-index:2;display:inline-flex;align-items:center;gap:10px;background:#fff;color:var(--navy);font-size:var(--fs-label);font-weight:800;letter-spacing:.1em;text-transform:uppercase;padding:12px 22px;border-radius:999px;box-shadow:0 6px 18px rgba(0,0,0,.18)}
.citytag i{width:12px;height:12px;border-radius:50%;background:var(--accent);display:inline-block}

/* обложка: текст сверху, картинка снизу на половину */
.cover .ct{padding-bottom:30px}
.cover .pill{align-self:flex-start;font-size:var(--fs-label);font-weight:800;letter-spacing:.14em;text-transform:uppercase;padding:12px 22px;border-radius:999px;background:var(--accent);color:#fff;margin-bottom:28px}
.cover .rub{font-size:var(--fs-label);font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.75);margin-left:auto}
.cover-ill{height:600px;flex:0 0 auto;margin:0 calc(-1 * var(--pad));border-radius:36px 36px 0 0;overflow:hidden;position:relative}
.cover-ill img{width:100%;height:100%;object-fit:cover;object-position:50% 45%;display:block}
.cover .cities{margin-top:22px;font-size:var(--fs-label);font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.85)}
.swipe{font-size:26px;font-weight:700;color:rgba(255,255,255,.85)}

/* списки и шаги */
.card{background:#fff;border-radius:22px;padding:26px 32px;font-size:var(--fs-body);font-weight:600;color:var(--navy);box-shadow:0 8px 24px rgba(40,52,138,.07);margin-top:18px;line-height:1.3}
.card small{display:block;font-size:var(--fs-small);font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.steps{margin-top:36px}
.step{display:flex;gap:24px;align-items:flex-start;margin-top:26px}
.step b{flex:0 0 60px;height:60px;border-radius:50%;background:#fff;color:var(--accent);font-family:var(--display);font-size:30px;display:flex;align-items:center;justify-content:center}
.bg-accent2 .step b{color:var(--accent2)}
.step span{font-size:var(--fs-body);font-weight:600;line-height:1.3;padding-top:8px}

/* человек: коллаж с фото или карточка с именем */
.collage{position:relative;width:600px;flex:1 1 0;min-height:420px;max-height:640px;margin:36px auto 0}
.collage .paper{position:absolute;inset:0;background:var(--accent);transform:rotate(5deg);border-radius:6px;opacity:.9}
.collage .frame{position:absolute;inset:18px 24px 30px 18px;background:#fff;padding:16px;transform:rotate(-3deg);box-shadow:0 18px 40px rgba(20,26,46,.25)}
.collage .photo-in{position:relative;width:100%;height:100%;overflow:hidden;background:#ccc}
.collage .photo-in img{width:100%;height:100%;object-fit:cover;object-position:50% 18%;filter:grayscale(1) contrast(1.15) brightness(1.05);display:block}
.collage .photo-in::after{content:"";position:absolute;inset:0;background:#7fb8ff;mix-blend-mode:multiply;opacity:.55}
.collage .photo-in::before{content:"";position:absolute;inset:0;z-index:2;opacity:.18;mix-blend-mode:multiply;background-image:radial-gradient(#000 1.2px,transparent 1.6px);background-size:7px 7px}
.collage .tape{position:absolute;width:190px;height:50px;background:rgba(255,246,214,.82);top:6px;left:-40px;transform:rotate(-38deg);z-index:3}
.collage .who{position:absolute;left:-14px;bottom:-22px;z-index:4;background:var(--navy);color:#fff;padding:16px 24px;border-radius:14px;transform:rotate(-2deg);max-width:560px}
.collage .who b{display:block;font-family:var(--display);font-size:36px;line-height:1.05}
.collage .who span{font-size:var(--fs-small);font-weight:600;opacity:.85}
.namecard{display:inline-flex;flex-direction:column;align-self:flex-start;background:var(--navy);color:#fff;border-radius:22px;padding:26px 34px;margin-bottom:40px;transform:rotate(-1.5deg);box-shadow:0 16px 40px rgba(40,52,138,.25)}
.namecard b{font-family:var(--display);font-size:52px;line-height:1.05}
.namecard span{font-size:var(--fs-small);font-weight:600;opacity:.85;margin-top:8px;max-width:34ch}
.credit{font-size:var(--fs-small);opacity:.55;margin-top:18px}

/* вывод на светлом фоне (когда подряд нельзя ставить цветной) */
.bar{width:120px;height:10px;border-radius:5px;background:var(--accent);margin-bottom:36px}
.btn{display:inline-block;align-self:flex-start;font-size:30px;font-weight:800;padding:22px 42px;border-radius:999px;background:var(--sky);color:#fff;margin-top:48px}
</style></head><body>
{% set total = slides|length %}
{% macro tagline(s, n) -%}<span class="tag"><b>{{ '%02d' % (n - 1) }}</b>{% if s.eyebrow %}· {{ s.eyebrow }}{% endif %}</span>{%- endmacro %}
{% macro footer(n) -%}
<div class="ft"><img class="logo" src="{{ assets }}/logo-horizontal.png" alt="BIG Life">
  <div class="prog">{% for k in range(total) %}<i{% if k + 1 == n %} class="on"{% endif %}></i>{% endfor %}</div></div>
{%- endmacro %}
{% for s in slides %}{% set n = loop.index %}{% set bg = bgs[loop.index0] %}

{% if s.type == 'cover' %}
{% set cimg = dphotos.get(s.photo_ref) or ills.get(s.illustration_id) %}
<section class="f bg-navy cover" id="s{{ n }}">
  {% if not cimg %}<div class="glow"></div>{% endif %}
  <div class="hd"><img class="logo" src="{{ assets }}/logo-horizontal.png" alt="BIG Life"><span class="rub">{{ rubric_title }}</span></div>
  <div class="ct{% if not cimg %} mid{% endif %}">
    {% if s.eyebrow and s.eyebrow|lower|replace(' ', ' ') != rubric_title|lower %}<span class="pill">{{ s.eyebrow }}</span>{% endif %}
    <h1{% if cimg %} style="font-size:88px"{% endif %}>{{ s.title }}</h1>
    {% if cities %}<div class="cities">{{ cities|join(' · ') }}</div>{% endif %}
    {% if not cimg %}<div class="swipe" style="margin-top:48px">Листайте →</div>{% endif %}
  </div>
  {% if cimg %}<div class="cover-ill{% if ills.get(s.illustration_id) and not dphotos.get(s.photo_ref) %} ill{% endif %}"><img src="{{ cimg }}" alt=""></div>{% endif %}
</section>

{% elif s.type == 'cta' %}
<section class="f bg-navy" id="s{{ n }}">
  <div class="glow"></div>
  <div class="hd"><img class="logo" src="{{ assets }}/logo-horizontal.png" alt="BIG Life"></div>
  <div class="ct mid">
    <div class="big">{{ s.title }}</div>
    {% if s.text %}<p>{{ s.text }}</p>{% endif %}
    <span class="btn">{{ s.eyebrow or 'Активности двора в BIG App' }}</span>
  </div>
  {{ footer(n) }}
</section>

{% elif s.type == 'lead' %}{# лид: расшифровка заголовка, текст крупнее обычного — его читают целиком #}
<section class="f bg-light" id="s{{ n }}">
  <div class="hd">{{ tagline(s, n) }}</div>
  <div class="ct mid">
    <div class="bar"></div>
    {% if s.title %}<h2>{{ s.title }}</h2>{% endif %}
    {% if s.text %}<p class="lead">{{ s.text }}</p>{% endif %}
  </div>
  {{ footer(n) }}
</section>

{% elif s.type == 'insight' %}
<section class="f bg-light" id="s{{ n }}">
  <div class="hd">{{ tagline(s, n) }}</div>
  <div class="ct{% if not (ills.get(s.illustration_id) or photo) %} mid{% endif %}">
    <h2>{{ s.title }}</h2>
    {% if s.text %}<p>{{ s.text }}</p>{% endif %}
    {% if ills.get(s.illustration_id) %}<div class="media ill"><img src="{{ ills[s.illustration_id] }}" alt=""></div>
    {% elif photo %}<div class="media"><img src="{{ photo }}" alt=""></div>{% endif %}
  </div>
  {{ footer(n) }}
</section>

{% elif s.type == 'event' %}
<section class="f bg-light" id="s{{ n }}">
  <div class="hd">{{ tagline(s, n) }}</div>
  <div class="ct">
    {% if dphotos.get(s.photo_ref) %}<div class="media" style="margin-top:0;margin-bottom:36px"><img src="{{ dphotos[s.photo_ref] }}" alt="">
      {% if photo_city.get(s.photo_ref) %}<span class="citytag"><i></i>{{ photo_city[s.photo_ref] }}</span>{% endif %}</div>{% endif %}
    <h2>{{ s.title }}</h2>
    {% if s.text %}<p style="margin-top:20px">{{ s.text }}</p>{% endif %}
  </div>
  {{ footer(n) }}
</section>

{% elif s.type == 'person' %}{% set pic = pictures.get(s.person, {}) %}{% set ref = people.get(s.person, {}) %}
<section class="f bg-light" id="s{{ n }}">
  <div class="hd">{{ tagline(s, n) }}</div>
  {% if pic.uri %}
  <div class="ct">
    <div class="collage">
      <div class="paper"></div>
      <div class="frame"><div class="tape"></div><div class="photo-in"><img src="{{ pic.uri }}" alt=""></div></div>
      <div class="who"><b>{{ ref.name_ru or s.person }}</b>{% if ref.role_ru %}<span>{{ ref.role_ru }}</span>{% endif %}</div>
    </div>
    <h2 style="margin-top:64px">{{ s.title }}</h2>
    {% if s.text %}<p style="margin-top:20px">{{ s.text }}</p>{% endif %}
    <div class="credit">{{ pic.credit }}</div>
  </div>
  {% else %}{# свободного фото нет — карточка с именем, без заглушки #}
  <div class="ct mid">
    <div class="namecard"><b>{{ ref.name_ru or s.person }}</b>{% if ref.role_ru %}<span>{{ ref.role_ru }}</span>{% endif %}</div>
    <h2>{{ s.title }}</h2>
    {% if s.text %}<p>{{ s.text }}</p>{% endif %}
  </div>
  {% endif %}
  {{ footer(n) }}
</section>

{% elif s.type == 'stat' %}
<section class="f bg-{{ bg }}" id="s{{ n }}">
  <div class="hd">{{ tagline(s, n) }}</div>
  <div class="ct mid">
    {% if bg == 'light' %}<div class="bar"></div>{% endif %}
    {% set L = s.title|length %}
    <div class="statnum" style="font-size:{{ 240 if L <= 4 else (190 if L <= 7 else (150 if L <= 10 else 112)) }}px{% if bg == 'light' %};color:var(--accent){% endif %}">{{ s.title }}</div>
    {% if s.text %}<p style="font-weight:600;font-size:{{ 32 if s.viz and s.viz.kind != 'none' else 40 }}px;line-height:1.3">{{ s.text }}</p>{% endif %}
    {% if s.viz and s.viz.kind and s.viz.kind != 'none' %}<canvas class="viz" data-viz='{{ s.viz | tojson }}'></canvas>{% endif %}
  </div>
  {{ footer(n) }}
</section>

{% elif s.type == 'statement' %}
<section class="f bg-{{ bg }}" id="s{{ n }}">
  <div class="hd">{{ tagline(s, n) }}</div>
  <div class="ct mid">
    {% if bg == 'light' %}<div class="bar"></div>{% endif %}
    <div class="big">{{ s.title }}</div>
    {% if s.text %}<p style="font-weight:600">{{ s.text }}</p>{% endif %}
  </div>
  {{ footer(n) }}
</section>

{% elif s.type == 'steps' %}
<section class="f bg-{{ bg }}" id="s{{ n }}">
  <div class="hd">{{ tagline(s, n) }}</div>
  <div class="ct mid">
    <h2>{{ s.title }}</h2>
    {% if s.text %}<p>{{ s.text }}</p>{% endif %}
    <div class="steps">{% for it in s['items'] %}<div class="step"><b{% if bg == 'light' %} style="background:var(--accent);color:#fff"{% endif %}>{{ loop.index }}</b><span>{{ it }}</span></div>{% endfor %}</div>
  </div>
  {{ footer(n) }}
</section>

{% elif s.type == 'list' %}
<section class="f bg-light" id="s{{ n }}">
  <div class="hd">{{ tagline(s, n) }}</div>
  <div class="ct mid">
    <h2>{{ s.title }}</h2>
    {% if s.text %}<p>{{ s.text }}</p>{% endif %}
    <div style="margin-top:22px">{% for it in s['items'] %}<div class="card">{% if s.item_labels[loop.index0] %}<small>{{ s.item_labels[loop.index0] }}</small>{% endif %}{{ it }}</div>{% endfor %}</div>
  </div>
  {{ footer(n) }}
</section>

{% else %}{# question #}
<section class="f bg-{{ bg }}" id="s{{ n }}">
  <div class="hd">{{ tagline(s, n) }}</div>
  <div class="ct mid">
    <h2 style="font-size:76px">{{ s.title }}</h2>
    {% if s.text %}<p>{{ s.text }}</p>{% endif %}
    <div style="margin-top:22px">{% for it in s['items'] %}<div class="card">{{ it }}</div>{% endfor %}</div>
  </div>
  {{ footer(n) }}
</section>
{% endif %}
{% endfor %}
<script>{{ viz_js | safe }}</script>
<script>
// Автоподгонка: заголовки уменьшаются, пока не влезут, но не ниже минимума шкалы.
// Если и на минимуме не влезает — это сигнал сократить текст, а не мельчить: пишем в отчёт.
(function () {
  function wide(el) { return el.scrollWidth > el.clientWidth + 2; }
  function over(sec) {
    const ct = sec.querySelector('.ct'); if (!ct) return false;
    const b = ct.getBoundingClientRect();
    return [...ct.children].some(c => {
      if (getComputedStyle(c).position === 'absolute') return false;
      const r = c.getBoundingClientRect();
      return r.height && (r.bottom > b.bottom + 2 || r.top < b.top - 2);
    });
  }
  const MIN = {H1: 64, H2: 52};
  window.layoutIssues = [];
  window.fitAll = function (selector) {
    document.querySelectorAll(selector).forEach((sec, idx) => {
      const heads = [...sec.querySelectorAll('h1,h2,.big,.statnum')];
      const floor = new Map(heads.map(h => [h, Math.max(MIN[h.tagName] || 56, parseFloat(getComputedStyle(h).fontSize) * 0.6)]));
      for (let guard = 0; guard < 40 && heads.length; guard++) {
        const w = heads.filter(wide);
        if (!w.length && !over(sec)) break;
        const targets = (w.length ? w : heads).filter(h => parseFloat(getComputedStyle(h).fontSize) * 0.94 >= floor.get(h));
        if (!targets.length) break;
        targets.forEach(h => { h.style.fontSize = (parseFloat(getComputedStyle(h).fontSize) * 0.94) + 'px'; });
      }
      if (heads.some(wide) || over(sec)) window.layoutIssues.push((idx + 1) + ': текст не помещается, нужно сократить');
    });
  };
})();
document.fonts.ready.then(() => {
  fitAll('section.f');
  // слайд данных: та же инфографика, что в Reels, в конечном состоянии
  document.querySelectorAll('canvas.viz').forEach(c => window.drawViz(c, JSON.parse(c.dataset.viz), null, 99));
  document.body.dataset.fitted = '1';
});
</script>
</body></html>
