<!doctype html>
<html lang="ru"><head><meta charset="utf-8">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&display=swap">
<style>
@font-face{font-family:"TT Firs Neue";src:url("{{ assets }}/TT_Firs_Neue_Trial_Var_Roman.ttf") format("truetype-variations");font-weight:100 900}
:root{--navy:#28348a;--sky:#009fe3;--green:#88c947;--orange:#ff954c;--periwinkle:#556bb8;--accent:var(--{{ accent }})}
*{box-sizing:border-box}body{margin:0}
/* Обложка по системе каруселей: текст сверху, картинка снизу. В сетке профиля обложка обрезается
   до 1080×1440 по центру (240–1680 по высоте), поэтому всё важное — в этой зоне. */
#cover{position:relative;width:1080px;height:1920px;overflow:hidden;background:var(--navy);color:#fff;font-family:"Montserrat",sans-serif}
.glow{position:absolute;width:1100px;height:1100px;border-radius:50%;right:-420px;top:-380px;background:radial-gradient(circle,color-mix(in srgb,var(--accent) 60%,transparent),transparent 62%)}
.zone{position:absolute;left:90px;right:90px;top:300px;bottom:300px;display:flex;flex-direction:column}
.zone.mid{justify-content:center}
.hd{display:flex;justify-content:space-between;align-items:center}
.logo{height:50px;filter:brightness(0) invert(1)}
.tag{font-size:28px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;padding:14px 26px;border-radius:999px;background:var(--accent)}
h1{font-family:"TT Firs Neue","Montserrat",sans-serif;font-weight:800;letter-spacing:-.02em;line-height:.98;margin:56px 0 0;font-size:{{ 120 if title|length < 25 else 100 }}px}
.media{flex:1 1 0;min-height:420px;margin-top:56px;border-radius:36px;overflow:hidden;background:#fff}
.media img{width:100%;height:100%;object-fit:cover;display:block}
</style></head><body>
<div id="cover">{% if not image %}<div class="glow"></div>{% endif %}
  <div class="zone{% if not image %} mid{% endif %}">
    <div class="hd"><img class="logo" src="{{ assets }}/logo-horizontal.png" alt=""><span class="tag">{{ rubric_title }}</span></div>
    <h1>{{ title }}</h1>
    {% if image %}<div class="media"><img src="{{ image }}" alt=""></div>{% endif %}
  </div>
</div></body></html>
