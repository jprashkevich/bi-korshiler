<!doctype html>
<html lang="ru"><head><meta charset="utf-8">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=Caveat:wght@600;700&display=swap">
<style>
@font-face{font-family:"TT Firs Neue";src:url("{{ assets }}/TT_Firs_Neue_Trial_Var_Roman.ttf") format("truetype-variations");font-weight:100 900}
/* Формат 4 (согласован с владельцем по эскизам A–D): редакционный коллаж + дата-арт на тёплом
   кремовом фоне. Сюжет собирается из кадров трёх типов: фото с графикой поверх → стол-коллаж
   с карточками, по которому ездит камера → дата-арт на весь кадр. Текст — субтитры-плашки.
   Зоны 1080×1920: сверху до 140 и снизу от 1600 — интерфейс Instagram. */
:root{--navy:#28348a;--sky:#009fe3;--green:#88c947;--orange:#ff954c;--periwinkle:#556bb8;--cream:#f6efe4;--ink:#2b3350;
--accent:var(--{{ accent }});--accent2:var(--{{ accent2 }});
--display:"TT Firs Neue","Montserrat",sans-serif}
*{box-sizing:border-box}html,body{margin:0;width:1080px;height:1920px;overflow:hidden;background:var(--cream);font-family:Montserrat,sans-serif}
#stage{position:relative;width:1080px;height:1920px;overflow:hidden;background:var(--cream);color:var(--navy)}
.grain{position:absolute;inset:0;z-index:30;pointer-events:none;opacity:.2;mix-blend-mode:multiply;
 background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/><feColorMatrix values='0 0 0 0 0.4 0 0 0 0 0.35 0 0 0 0 0.3 0 0 0 .55 0'/></filter><rect width='220' height='220' filter='url(%23n)'/></svg>")}
#logo{position:absolute;left:50%;top:142px;transform:translateX(-50%);height:38px;z-index:25;background:var(--cream);padding:10px 18px;border-radius:999px;box-sizing:content-box}
.shot{position:absolute;inset:0;opacity:0;will-change:opacity,transform}
/* фото во весь кадр */
.photo{overflow:hidden;background:#222}
.photo img.bg{position:absolute;top:0;height:100%;width:auto;max-width:none;filter:saturate(.9)}
.photo .shade{position:absolute;inset:0;z-index:3;background:linear-gradient(180deg,rgba(20,24,60,.55) 0,rgba(20,24,60,0) 32%,rgba(20,24,60,0) 60%,rgba(20,24,60,.35) 100%)}
.photo canvas{position:absolute;left:0;top:860px;width:1080px;height:440px;color:#fff}
.photo .scene{z-index:4}
.photo .scene{color:#fff}
/* стол-коллаж */
.collage{background:var(--cream)}
.desk{position:absolute;left:0;top:0;width:1080px;transform-origin:540px 0}
.card{position:absolute;background:#fff;padding:16px;box-shadow:0 18px 40px rgba(60,40,20,.2);opacity:0}
.card img{display:block;width:100%;height:100%;object-fit:cover}
.card.person img{object-position:50% 18%;filter:grayscale(1) contrast(1.1)}
.tape{position:absolute;width:160px;height:44px;background:rgba(255,244,210,.9);top:-20px;left:50%;margin-left:-80px;transform:rotate(-4deg)}
.note{background:#fffdf7;padding:40px 46px;font-size:50px;line-height:1.36;font-weight:700;color:var(--ink)}
.note .hand{font-family:Caveat,cursive;color:var(--accent);font-weight:700;font-size:62px}
.datacard{padding:22px}
.datacard canvas{display:block;width:100%;height:100%}
.datacard .legend{position:absolute;left:24px;bottom:14px;font-size:22px;font-weight:700;opacity:.7}
.bignum{position:absolute;font-family:var(--display);font-weight:800;color:var(--navy);letter-spacing:-.03em;line-height:.9;opacity:0}
.bignum small{display:block;font-family:Montserrat;font-size:28px;font-weight:700;letter-spacing:0;line-height:1.3;color:var(--ink);opacity:.8;margin-top:12px;max-width:380px}
.tagname{position:absolute;left:0;bottom:-58px;background:var(--accent);color:#fff;font-weight:800;font-size:28px;padding:8px 18px;border-radius:12px;white-space:nowrap}
.tagrole{position:absolute;left:0;bottom:-104px;background:#fff;color:var(--navy);font-weight:700;font-size:22px;padding:7px 16px;border-radius:12px;white-space:nowrap;box-shadow:0 4px 12px rgba(0,0,0,.08)}
.deco{position:absolute;opacity:0}
.pen path{stroke-dasharray:100;stroke-dashoffset:100}
/* дата-арт */
.dataart{background:var(--cream)}
.dataart .scene{position:absolute;left:40px;right:40px;top:250px;height:1060px;color:var(--navy)}
.dataart canvas{width:100%;height:100%}
/* хук и субтитры */
#hook{position:absolute;left:80px;right:80px;top:290px;z-index:26;font-family:var(--display);font-weight:800;font-size:112px;line-height:.98;letter-spacing:-.02em;opacity:0}
#hook.on-photo{color:#fff;text-shadow:0 6px 30px rgba(10,14,50,.45)}
#hook .hl{color:var(--accent)}
#sub{position:absolute;left:70px;right:70px;top:1330px;z-index:27;text-align:center}
#sub span{display:inline;font-size:50px;font-weight:700;line-height:1.5;color:var(--navy);background:#fff;padding:6px 20px;border-radius:16px;
  box-shadow:0 6px 18px rgba(40,52,138,.12);-webkit-box-decoration-break:clone;box-decoration-break:clone}
#sub b{font-weight:900;background:color-mix(in srgb,var(--accent) 50%,#fff);border-radius:10px;padding:0 8px}
#sub.hidden{display:none}
#endtag{position:absolute;left:50%;transform:translateX(-50%);top:1520px;z-index:27;font-weight:800;font-size:28px;color:var(--navy);opacity:0;
  background:#fff;padding:12px 26px;border-radius:999px;white-space:nowrap;box-shadow:0 6px 18px rgba(40,52,138,.12)}
</style></head><body>
<div id="stage">
  <img id="logo" src="{{ assets }}/logo-horizontal.png" alt="BIG Life">
  {% for r in runs %}
  {% if r.shot == 'photo' %}
  <div class="shot photo" id="run{{ loop.index0 }}">
    {% for ph in r.photos %}<img class="bg" data-k="{{ loop.index0 }}" src="{{ ph }}" alt="">{% endfor %}
    <div class="shade"></div>
    <div class="scene" style="position:absolute;inset:0;color:#fff"><canvas class="over"></canvas></div>
  </div>
  {% elif r.shot == 'collage' %}
  <div class="shot collage" id="run{{ loop.index0 }}">
    <div class="desk" style="height:{{ r.height }}px">
      <svg width="1080" height="{{ r.height }}" style="position:absolute;left:0;top:0">
        {% for d in r.decos %}
        {% if d.kind == 'half' %}<path class="deco" data-at="{{ d.at }}" d="M{{ d.x }} {{ d.y }} a{{ d.r }} {{ d.r }} 0 0 1 {{ 2 * d.r }} 0 z" fill="{{ d.color }}"/>
        {% elif d.kind == 'dot' %}<circle class="deco" data-at="{{ d.at }}" cx="{{ d.x }}" cy="{{ d.y }}" r="{{ d.r }}" fill="{{ d.color }}"/>
        {% elif d.kind == 'rule' %}<g class="deco" data-at="{{ d.at }}" stroke="#2b3350" stroke-width="2" opacity=".45"><line x1="60" y1="{{ d.y }}" x2="1020" y2="{{ d.y }}"/>{% for k in range(9) %}<line x1="{{ 60 + k * 120 }}" y1="{{ d.y }}" x2="{{ 60 + k * 120 }}" y2="{{ d.y + 14 }}"/>{% endfor %}</g>{% endif %}
        {% endfor %}
      </svg>
      {% for c in r.cards %}
      {% if c.kind == 'note' %}
      <div class="card note" data-at="{{ c.at }}" style="left:{{ c.x }}px;top:{{ c.y }}px;width:{{ c.w }}px;--rot:{{ c.rot }}deg">{% for line in c.lines %}{% if loop.last and c.lines|length > 2 %}<span class="hand">{{ line }}</span>{% else %}{{ line }}<br>{% endif %}{% endfor %}
        {% if c.lines|length > 2 %}<svg class="pen" data-pen="{{ c.at + 0.9 }}" viewBox="0 0 400 40" style="position:absolute;left:40px;bottom:18px;width:{{ c.w - 120 }}px;height:30px"><path d="M4 26 C 80 14, 160 34, 240 20 S 360 12, 396 22" fill="none" stroke="var(--accent)" stroke-width="6" stroke-linecap="round" pathLength="100"/></svg>{% endif %}</div>
      {% elif c.kind == 'photo' %}
      <div class="card{% if c.person %} person{% endif %}" data-at="{{ c.at }}" style="left:{{ c.x }}px;top:{{ c.y }}px;width:{{ c.w }}px;height:{{ c.h }}px;--rot:{{ c.rot }}deg"><img src="{{ c.uri }}" alt=""><div class="tape"></div>
        {% if c.name %}<span class="tagname">{{ c.name }}</span>{% endif %}{% if c.role %}<span class="tagrole">{{ c.role }}</span>{% endif %}</div>
      {% elif c.kind == 'data' %}
      <div class="card datacard scene" data-at="{{ c.at }}" data-viz='{{ c.viz | tojson }}' style="left:{{ c.x }}px;top:{{ c.y }}px;width:{{ c.w }}px;height:{{ c.h }}px;--rot:{{ c.rot }}deg;color:var(--navy)"><canvas></canvas>{% if c.viz.unit %}<span class="legend">{{ c.viz.unit }}</span>{% endif %}</div>
      {% elif c.kind == 'number' %}
      <div class="bignum" data-at="{{ c.at }}" data-count="{{ c.text }}" style="left:{{ c.x }}px;top:{{ c.y }}px;font-size:{{ c.size }}px"><span class="v">{{ c.text }}</span>{% if c.caption %}<small>{{ c.caption }}</small>{% endif %}
        <svg class="pen" data-pen="{{ c.at + 1.2 }}" viewBox="0 0 400 200" style="position:absolute;left:-40px;top:-30px;width:{{ (c.size * 2.6) | int }}px;height:{{ (c.size * 1.35) | int }}px;overflow:visible"><path d="M210 12 C 90 4, 10 50, 18 110 C 28 180, 300 196, 372 130 C 420 80, 340 10, 190 18" fill="none" stroke="var(--accent)" stroke-width="5" stroke-linecap="round" pathLength="100"/></svg></div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
  {% else %}
  <div class="shot dataart" id="run{{ loop.index0 }}"><div class="scene"><canvas></canvas></div></div>
  {% endif %}
  {% endfor %}
  <div id="hook" class="{% if runs[0].shot == 'photo' %}on-photo{% endif %}" style="font-size:{{ 112 if hook.title|length <= 28 else (96 if hook.title|length <= 44 else 84) }}px">{% for w in hook.title.split(' ') %}<span class="w{% if hook.highlight and hook.highlight|lower in w|lower %} hl{% endif %}">{{ w }}</span>{{ ' ' }}{% endfor %}</div>
  <div id="sub"><span></span></div>
  <div id="endtag">BIG Life · соседство в цифрах</div>
  <div class="grain"></div>
</div>
<script>{{ viz_js | safe }}</script>
<script>
const TL = {{ timeline | tojson }};
const SUBS = {{ subtitles | tojson }};
const RUNS = {{ runs_js | tojson }};    // [{shot, start, end, scenes:[{i, start, end, viz, focus}]}]
const HOOK_END = {{ hook_end }}, TOTAL = {{ total }};
const ease = x => 1 - Math.pow(1 - Math.min(Math.max(x, 0), 1), 3);
const inout = x => { x = Math.min(Math.max(x, 0), 1); return x < .5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2; };
const esc = s => s.replace(/[&<>]/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;'})[c]);
const FADE = 0.5;

function vizAt(run, t) {        // состояние фигуры внутри отрезка: последняя сцена с viz до момента t
  let cur = null, prev = null, start = run.start;
  run.scenes.forEach(s => { if (s.viz && t >= s.start) { if (cur && cur.kind === s.viz.kind) prev = cur; else prev = null; cur = s.viz; start = s.start; } });
  return {cur, prev, lt: t - start};
}

window.seek = function (t) {
  RUNS.forEach((r, k) => {
    const el = document.getElementById('run' + k);
    const fin = k === 0 ? 1 : ease((t - r.start) / FADE), fout = k === RUNS.length - 1 ? 1 : 1 - ease((t - r.end) / FADE);
    const vis = t >= r.start - 0.01 && t < r.end + FADE ? Math.min(fin, fout) : 0;
    el.style.opacity = vis;
    if (!vis) return;
    const lt = t - r.start, dur = Math.max(r.end - r.start, 1);
    // фразы голоса внутри отрезка: на каждой — смена снимка или акцентный толчок камеры
    const beats = SUBS.filter(s => s.start >= r.start - 0.05 && s.start < r.end).map(s => s.start);
    let bi = -1; beats.forEach((b, j) => { if (t >= b) bi = j; });
    const bt = bi >= 0 ? t - beats[bi] : lt, punch = 1 - ease(bt / 0.35);
    if (r.shot === 'photo') {
      const imgs = [...el.querySelectorAll('img.bg')], cur = Math.max(bi, 0) % imgs.length, prv = Math.max(bi - 1, 0) % imgs.length;
      imgs.forEach((img, j) => {
        if (!img.naturalWidth) return;
        const w = 1920 * img.naturalWidth / img.naturalHeight, span = Math.max(w - 1080, 0);
        const p = inout(bt / 4), dir = (j % 2 ? -1 : 1);
        img.style.width = w + 'px';
        img.style.transform = `translateX(${-span * (0.5 + dir * (0.3 - 0.25 * p))}px) scale(${1.08 + 0.05 * p + 0.05 * punch})`;
        img.style.opacity = j === cur ? ease(bt / 0.22) : (j === prv && bt < 0.22 ? 1 : 0);
        img.style.zIndex = j === cur ? 2 : 1;
      });
      el.style.transform = `scale(${1 + 0.04 * (1 - fout)})`;
      const v = vizAt(r, t);
      if (v.cur) window.drawViz(el.querySelector('canvas.over'), {...v.cur, overlay: true}, v.prev, v.lt);
    } else if (r.shot === 'collage') {
      const desk = el.querySelector('.desk');
      // камера переезжает к карточкам текущей сцены
      let fi = 0; r.scenes.forEach((s, j) => { if (t >= s.start) fi = j; });
      const a = r.scenes[Math.max(fi - 1, 0)].focus, b = r.scenes[fi].focus, m = inout((t - r.scenes[fi].start) / 0.7);
      const fy = a.y + (b.y - a.y) * (fi ? m : 1), fs = a.s + (b.s - a.s) * (fi ? m : 1);
      const outro = r.zoomout ? inout((t - (r.end - 1.4)) / 1.2) : 0;
      const s = fs * (1 - outro) + r.zoomout_s * outro, y = fy * (1 - outro) + r.zoomout_y * outro;
      const sp = s * (1 + 0.035 * punch);
      desk.style.transform = `translate(0px, ${760 - y * sp}px) scale(${sp})`;   // transform-origin по центру ширины
      desk.querySelectorAll('[data-at]').forEach(c => {
        const p = ease((t - parseFloat(c.dataset.at)) / 0.45);
        c.style.opacity = p;
        if (c.classList.contains('card')) c.style.transform = `rotate(var(--rot)) scale(${1.12 - 0.12 * p}) translateY(${(1 - p) * -40}px)`;
        if (c.classList.contains('datacard') && p > 0) window.drawViz(c.querySelector('canvas'), JSON.parse(c.dataset.viz), null, t - parseFloat(c.dataset.at));
        if (c.classList.contains('bignum') && p > 0) {
          const raw = c.dataset.count, mm = raw.match(/\d[\d\s ]*(?:[.,]\d+)?/);
          if (mm) { const val = parseFloat(mm[0].replace(/[\s ]/g, '').replace(',', '.')), dec = (mm[0].split(/[.,]/)[1] || '').length;
            let cur = (val * ease((t - parseFloat(c.dataset.at)) / 1.1)).toFixed(dec).replace('.', ',');
            if (cur.length > 4) cur = cur.replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
            c.querySelector('.v').textContent = raw.replace(mm[0], cur); }
        }
      });
    } else {
      const v = vizAt(r, t);
      if (v.cur) window.drawViz(el.querySelector('canvas'), v.cur, v.prev, v.lt);
      el.style.transform = `scale(${1.03 - 0.03 * ease(lt / 1.5) + 0.03 * punch})`;
    }
  });
  // рукописные пометки маркером: прорисовываются линией в свой момент
  document.querySelectorAll('[data-pen]').forEach(sv => {
    sv.firstElementChild.style.strokeDashoffset = 100 * (1 - ease((t - parseFloat(sv.dataset.pen)) / 0.6));
  });
  const hk = document.getElementById('hook');
  hk.style.opacity = Math.min(ease(t / 0.25), 1 - ease((t - HOOK_END) / 0.35));
  hk.querySelectorAll('.w').forEach((w, k) => { const p = ease((t - 0.03 * k) / 0.2); w.style.opacity = p; w.style.transform = `translateY(${(1 - p) * 30}px)`; });
  const sub = SUBS.find(s => t >= s.start && t < s.end), box = document.getElementById('sub');
  box.classList.toggle('hidden', !sub || t < HOOK_END - 0.05);
  if (sub) {
    const hl = (sub.hl || '').toLowerCase();
    box.firstElementChild.innerHTML = sub.text.split(' ').map(w => hl && w.toLowerCase().replace(/[.,!?:;«»"]/g, '').startsWith(hl.slice(0, Math.max(4, hl.length - 2))) ? `<b>${esc(w)}</b>` : esc(w)).join(' ');
  }
  document.getElementById('endtag').style.opacity = ease((t - (TOTAL - 2.2)) / 0.4);
};
Promise.all([...document.images].map(i => i.complete ? 0 : new Promise(r => { i.onload = i.onerror = r; })))
  .then(() => document.fonts.ready).then(() => { window.layoutIssues = []; window.seek(0); document.body.dataset.fitted = '1'; });
</script>
</body></html>
