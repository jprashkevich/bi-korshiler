<!doctype html>
<html lang="ru"><head><meta charset="utf-8">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&display=swap">
<style>
@font-face{font-family:"TT Firs Neue";src:url("{{ assets }}/TT_Firs_Neue_Trial_Var_Roman.ttf") format("truetype-variations");font-weight:100 900}
/* Формат 3 (по референсам владельца, tillo.journal): одна визуальная метафора идёт через весь ролик
   и развивается вместе с рассказом; текст — субтитры-плашки с жирным ключевым словом; иллюстрации
   и фото — карточками-коллажем поверх метафоры. Сцены не режут ролик на «инфографика — текст».
   Зоны 1080×1920: сверху до 140 и снизу от 1600 — интерфейс Instagram. */
:root{--navy:#28348a;--sky:#009fe3;--green:#88c947;--orange:#ff954c;--periwinkle:#556bb8;
--accent:var(--{{ accent }});--accent2:var(--{{ accent2 }});
--display:"TT Firs Neue","Montserrat",sans-serif;--text:"Montserrat",sans-serif}
*{box-sizing:border-box}html,body{margin:0;width:1080px;height:1920px;overflow:hidden;background:var(--navy);font-family:var(--text)}
#stage{position:relative;width:1080px;height:1920px;overflow:hidden;color:#fff}
.bg-navy{background:radial-gradient(120% 80% at 70% 10%,color-mix(in srgb,var(--accent) 22%,var(--navy)),var(--navy) 60%);color:#fff}
#logo{position:absolute;left:50%;top:150px;transform:translateX(-50%);height:38px;filter:brightness(0) invert(1);opacity:.9;z-index:9}
/* слой метафоры: весь ролик, под текстом */
#meta{position:absolute;left:60px;right:60px;top:250px;height:1060px;z-index:1}
#meta canvas{position:absolute;inset:0;width:100%;height:100%}
/* хук крупно поверх метафоры */
#hook{position:absolute;left:80px;right:80px;top:300px;z-index:5;font-family:var(--display);font-weight:800;
  font-size:118px;line-height:.98;letter-spacing:-.02em;opacity:0}
#hook .hl{color:var(--accent)}
/* цифра сцены stat — крупно в углу, метафора продолжает работать */
.num{position:absolute;left:80px;top:290px;z-index:5;font-family:var(--display);font-weight:800;font-size:190px;
  line-height:.9;letter-spacing:-.03em;color:#fff;opacity:0;text-shadow:0 8px 30px rgba(10,16,60,.5)}
/* карточки: иллюстрация или фото исследователя поверх метафоры */
.card{position:absolute;right:80px;top:330px;width:560px;z-index:4;opacity:0}
.card .ph{background:#fff;padding:16px;box-shadow:0 26px 60px rgba(0,0,0,.4)}
.card .ph img{display:block;width:100%;height:560px;object-fit:cover}
.card.person .ph img{object-position:50% 18%;filter:grayscale(1) contrast(1.1)}
.card .tape{position:absolute;width:190px;height:50px;background:rgba(255,246,214,.85);top:-18px;left:40px;transform:rotate(-6deg)}
.tagname{display:inline-block;margin-top:18px;background:var(--accent);color:#fff;font-weight:800;font-size:30px;padding:10px 20px;border-radius:12px}
.tagrole{display:block;width:fit-content;margin-top:8px;background:#fff;color:var(--navy);font-weight:700;font-size:24px;padding:8px 18px;border-radius:12px}
.credit{font-size:16px;opacity:.6;margin-top:8px}
/* субтитры-плашки: главный текст ролика */
#sub{position:absolute;left:70px;right:70px;top:1330px;z-index:8;text-align:center}
#sub span{display:inline;font-size:50px;font-weight:700;line-height:1.48;color:var(--navy);background:#fff;padding:6px 20px;border-radius:16px;
  -webkit-box-decoration-break:clone;box-decoration-break:clone}
#sub b{font-weight:900;color:var(--navy);background:color-mix(in srgb,var(--accent) 45%,#fff);border-radius:10px;padding:0 8px}
#sub.hidden{display:none}
#endtag{position:absolute;left:50%;transform:translateX(-50%);top:1500px;z-index:8;font-weight:800;font-size:30px;color:#fff;opacity:0;
  background:rgba(255,255,255,.16);padding:12px 26px;border-radius:999px;white-space:nowrap}
</style></head><body>
<div id="stage" class="bg-navy">
  <img id="logo" src="{{ assets }}/logo-horizontal.png" alt="BIG Life">
  <div id="meta" class="bg-navy" style="background:none"><canvas id="vizA"></canvas><canvas id="vizB"></canvas></div>
  <div id="hook">{% for w in hook.title.split(' ') %}<span class="w{% if hook.highlight and hook.highlight|lower in w|lower %} hl{% endif %}">{{ w }}</span>{{ ' ' }}{% endfor %}</div>
  {% for s in scenes %}
    {% if s.type == 'stat' and s.title %}<div class="num" id="num{{ loop.index0 }}" data-count="{{ s.title }}">{{ s.title }}</div>{% endif %}
    {% set c = cards[loop.index0] %}
    {% if c %}<div class="card{% if c.person %} person{% endif %}" id="card{{ loop.index0 }}">
      <div class="tape"></div><div class="ph"><img src="{{ c.uri }}" alt=""></div>
      {% if c.name %}<span class="tagname">{{ c.name }}</span>{% endif %}{% if c.role %}<span class="tagrole">{{ c.role }}</span>{% endif %}
      {% if c.credit %}<div class="credit">{{ c.credit }}</div>{% endif %}
    </div>{% endif %}
  {% endfor %}
  <div id="sub"><span></span></div>
  <div id="endtag">BIG Life · соседство в цифрах</div>
</div>
<script>{{ viz_js | safe }}</script>
<script>
const TL = {{ timeline | tojson }};      // [{start, end}] сцены
const SUBS = {{ subtitles | tojson }};   // [{start, end, text, hl}]
const VIZ = {{ vizs | tojson }};         // состояние метафоры на каждую сцену (протянуто вперёд)
const RUN = {{ runs | tojson }};         // начало непрерывного отрезка с тем же состоянием
const HOOK_END = {{ hook_end }};
const TOTAL = {{ total }};
const ease = x => 1 - Math.pow(1 - Math.min(Math.max(x, 0), 1), 3);
const A = document.getElementById('vizA'), B = document.getElementById('vizB');
const esc = s => s.replace(/[&<>]/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;'})[c]);

function sceneAt(t) { let i = 0; TL.forEach((s, k) => { if (t >= s.start) i = k; }); return i; }

window.seek = function (t) {
  const i = sceneAt(t), seg = TL[i];
  // метафора: внутри непрерывного отрезка время не сбрасывается, смена формы — плавным перетеканием
  const spec = VIZ[i];
  const ctxA = A.getContext('2d');
  if (spec) {
    const lt = t - TL[RUN[i]].start;
    const prevI = RUN[i] - 1;
    const prev = prevI >= 0 ? VIZ[prevI] : null;
    const same = prev && spec && prev.kind === spec.kind;
    window.drawViz(A, spec, same ? prev : null, lt);
    const k = ease(lt / 0.7);
    if (prev && !same && k < 1) {
      window.drawViz(B, prev, null, t - TL[RUN[prevI]].start);
      B.style.opacity = 1 - k; A.style.opacity = k;
    } else { B.style.opacity = 0; A.style.opacity = 1; }
  } else { ctxA.clearRect(0, 0, A.width, A.height); B.style.opacity = 0; }
  // хук крупно в начале, метафора за ним приглушена
  const hk = document.getElementById('hook');
  const hIn = ease(t / 0.25), hOut = 1 - ease((t - HOOK_END) / 0.35);
  hk.style.opacity = Math.min(hIn, hOut);
  hk.querySelectorAll('.w').forEach((w, k) => { const p = ease((t - 0.03 * k) / 0.2); w.style.opacity = p; w.style.transform = `translateY(${(1 - p) * 30}px)`; });
  const dim = 1 - 0.6 * Math.min(hIn, hOut);
  // карточки и цифры живут, пока идёт их сцена
  let cardShown = 0;
  TL.forEach((s, k) => {
    const on = t >= s.start && t < s.end + 0.1, p = ease((t - s.start) / 0.35), q = 1 - ease((t - s.end) / 0.25);
    const card = document.getElementById('card' + k);
    if (card) {
      const v = on ? Math.min(p, q) : 0; cardShown = Math.max(cardShown, v);
      card.style.opacity = v;
      card.style.transform = `translateX(${(1 - p) * 300}px) rotate(${3 - (1 - p) * 8}deg) translateY(${-8 * Math.sin((t - s.start) * 1.1)}px)`;
    }
    const num = document.getElementById('num' + k);
    if (num) {
      num.style.opacity = on ? Math.min(p, q) : 0;
      const raw = num.dataset.count, m = raw.match(/\d[\d\s ]*(?:[.,]\d+)?/);
      if (m && on) {
        const val = parseFloat(m[0].replace(/[\s ]/g, '').replace(',', '.')), dec = (m[0].split(/[.,]/)[1] || '').length;
        const cur = (val * ease((t - s.start) / 1.1)).toFixed(dec).replace('.', ',');
        num.textContent = raw.replace(m[0], cur.length > 4 ? cur.replace(/\B(?=(\d{3})+(?!\d))/g, ' ') : cur);
      }
    }
  });
  document.getElementById('meta').style.opacity = dim * (1 - 0.45 * cardShown);
  // субтитры-плашки: фраза целиком, ключевое слово жирным
  const sub = SUBS.find(s => t >= s.start && t < s.end), box = document.getElementById('sub');
  box.classList.toggle('hidden', !sub || t < HOOK_END - 0.05);
  if (sub) {
    const hl = (sub.hl || '').toLowerCase();
    box.firstElementChild.innerHTML = sub.text.split(' ').map(w => hl && w.toLowerCase().replace(/[.,!?:;«»"]/g, '').startsWith(hl.slice(0, Math.max(4, hl.length - 2))) ? `<b>${esc(w)}</b>` : esc(w)).join(' ');
  }
  const end = document.getElementById('endtag');
  end.style.opacity = ease((t - (TOTAL - 2.2)) / 0.4);
};
document.fonts.ready.then(() => { window.layoutIssues = []; window.seek(0); document.body.dataset.fitted = '1'; });
</script>
</body></html>
