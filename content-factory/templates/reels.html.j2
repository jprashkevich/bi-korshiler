<!doctype html>
<html lang="ru"><head><meta charset="utf-8">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&display=swap">
<style>
@font-face{font-family:"TT Firs Neue";src:url("{{ assets }}/TT_Firs_Neue_Trial_Var_Roman.ttf") format("truetype-variations");font-weight:100 900}
/* Та же система, что у каруселей (ревизия 2): токены, шкала, ритм фонов, «01 · ЭТИКЕТКА».
   Зоны 1080×1920 под интерфейс Instagram: сверху 0–140 и снизу от 1600 перекрыто кнопками и подписью,
   поэтому шапка на 150, контент 300–1380, субтитры 1430–1580. */
:root{--navy:#28348a;--sky:#009fe3;--green:#88c947;--orange:#ff954c;--periwinkle:#556bb8;
--ink:#2b3350;--light:#f5f7fb;--accent:var(--{{ accent }});--accent2:var(--{{ accent2 }});
--display:"TT Firs Neue","Montserrat",sans-serif;--text:"Montserrat",sans-serif;
--fs-hook:112px;--fs-h1:116px;--fs-h2:80px;--fs-stat:280px;--fs-body:42px;--fs-label:28px;--r:36px}
*{box-sizing:border-box}html,body{margin:0;width:1080px;height:1920px;overflow:hidden;background:var(--navy);font-family:var(--text)}
#stage{position:relative;width:1080px;height:1920px;overflow:hidden;background:var(--navy)}
.scene{position:absolute;inset:0;opacity:0;overflow:hidden}
.bg-navy{background:var(--navy);color:#fff}.bg-light{background:var(--light);color:var(--navy)}
.bg-accent{background:var(--accent);color:#fff}.bg-accent2{background:var(--accent2);color:#fff}
.glow{position:absolute;width:1100px;height:1100px;border-radius:50%;right:-420px;top:-380px;background:radial-gradient(circle,color-mix(in srgb,var(--accent) 60%,transparent),transparent 62%)}
.hd{position:absolute;left:90px;right:90px;top:150px;display:flex;justify-content:space-between;align-items:center;z-index:3}
.tag{display:inline-flex;align-items:center;gap:12px;font-size:var(--fs-label);font-weight:800;letter-spacing:.14em;text-transform:uppercase;padding:14px 26px;border-radius:999px}
.bg-light .tag{background:#fff;color:var(--navy);box-shadow:0 4px 14px rgba(40,52,138,.08)}
.bg-light .tag b{color:var(--accent)}
.bg-navy .tag,.bg-accent .tag,.bg-accent2 .tag{background:rgba(255,255,255,.18);color:#fff}
.logo{height:50px}
.bg-navy .logo,.bg-accent .logo,.bg-accent2 .logo{filter:brightness(0) invert(1)}
.bar{position:absolute;left:90px;right:90px;top:240px;height:6px;border-radius:3px;background:currentColor;opacity:.2;z-index:3}
.barfill{position:absolute;left:90px;top:240px;height:6px;border-radius:3px;background:currentColor;width:0;z-index:3}
.ct{position:absolute;left:90px;right:90px;top:300px;bottom:540px;display:flex;flex-direction:column;justify-content:center;z-index:2}
.ct.top{justify-content:flex-start;padding-top:40px}
.title{font-family:var(--display);font-weight:800;letter-spacing:-.02em;line-height:1.0;font-size:var(--fs-h1)}
.hook .title{font-size:140px;line-height:.96}
.hook .ct{top:260px}
.hl{color:var(--accent)}
.bg-accent .hl,.bg-accent2 .hl{color:var(--navy)}
.bg-light .hl{color:var(--accent)}
.ct.top .title{font-size:var(--fs-h2);line-height:1.04}
.text{font-size:var(--fs-body);font-weight:600;line-height:1.4;margin-top:36px;max-width:24ch}
.bg-light .text{color:var(--ink)}
.stat{font-family:var(--display);font-weight:800;letter-spacing:-.03em;line-height:.9;font-size:var(--fs-stat)}
.w{display:inline-block;will-change:transform,opacity}
/* медиа: текст сверху, картинка забирает остаток зоны */
.vis{position:relative;margin-top:48px;flex:1 1 0;min-height:420px;max-height:760px}
.ill{border-radius:var(--r);overflow:hidden;background:#fff;box-shadow:0 24px 60px rgba(0,0,0,.25)}
.ill img{width:100%;height:100%;object-fit:cover;display:block;transform-origin:50% 60%}
.collage{width:640px;align-self:center}
.collage .paper{position:absolute;inset:0;background:var(--accent);border-radius:6px}
.collage .frame{position:absolute;inset:18px 24px 30px 18px;background:#fff;padding:18px;box-shadow:0 22px 50px rgba(0,0,0,.35)}
.collage .photo-in{position:relative;width:100%;height:100%;overflow:hidden;background:#ccc}
.collage .photo-in img{width:100%;height:100%;object-fit:cover;object-position:50% 18%;filter:grayscale(1) contrast(1.15) brightness(1.05);display:block}
.collage .photo-in::after{content:"";position:absolute;inset:0;background:#7fb8ff;mix-blend-mode:multiply;opacity:.55}
.collage .photo-in::before{content:"";position:absolute;inset:0;z-index:2;opacity:.18;mix-blend-mode:multiply;background-image:radial-gradient(#000 1.3px,transparent 1.7px);background-size:8px 8px}
.collage .tape{position:absolute;width:210px;height:54px;background:rgba(255,246,214,.85);top:8px;left:-44px;z-index:3}
.collage .who{position:absolute;left:-30px;bottom:-30px;z-index:4;background:var(--navy);color:#fff;padding:20px 28px;border-radius:16px;max-width:600px}
.collage .who b{display:block;font-family:var(--display);font-size:44px;line-height:1.05}
.collage .who span{font-size:26px;font-weight:700;opacity:.8}
.credit{position:absolute;left:0;right:0;bottom:-80px;font-size:18px;opacity:.6;text-align:center}
.namecard{display:inline-flex;flex-direction:column;align-self:flex-start;background:var(--navy);color:#fff;border-radius:28px;padding:34px 42px;margin-top:48px;max-width:860px;flex:0 0 auto;min-height:0}
.namecard b{font-family:var(--display);font-size:72px;line-height:1.05}
.namecard span{font-size:34px;font-weight:700;opacity:.8;margin-top:12px}
#sub{position:absolute;left:70px;right:70px;top:1430px;text-align:center;z-index:6}
#sub span{display:inline;font-size:48px;font-weight:800;line-height:1.5;color:#fff;background:rgba(12,20,70,.82);padding:6px 18px;border-radius:14px;-webkit-box-decoration-break:clone;box-decoration-break:clone}
#sub b{font-weight:800;color:rgba(255,255,255,.45)}#sub b.on{color:#fff}
#sub.hidden{display:none}
</style></head><body>
<div id="stage">
  {% for s in scenes %}{% set bg = bgs[loop.index0] %}
  {% set has_vis = (s.type == 'person') or ills.get(s.illustration_id) %}
  <div class="scene bg-{{ bg }} {{ s.type }}" id="sc{{ loop.index0 }}">
    {% if bg == 'navy' %}<div class="glow"></div>{% endif %}
    {# пробные Reels видят незнакомые с брендом: в начале только смысл, логотип — в финале #}
    {% if s.type != 'hook' %}<div class="hd">{% if s.eyebrow %}<span class="tag">{{ s.eyebrow }}</span>{% else %}<span></span>{% endif %}
      {% if s.type == 'cta' %}<img class="logo" src="{{ assets }}/logo-horizontal.png" alt="BIG Life">{% endif %}</div>{% endif %}
    <div class="bar"></div><div class="barfill"></div>
    <div class="ct{% if has_vis %} top{% endif %}">
    {% if s.type == 'stat' %}
      <div class="stat" data-count="{{ s.title }}" style="font-size:{{ 280 if s.title|length < 7 else (210 if s.title|length < 11 else 150) }}px">{{ s.title }}</div>
    {% else %}
      <div class="title">{% for w in s.title.split(' ') %}<span class="w{% if s.highlight and s.highlight|lower in w|lower %} hl{% endif %}">{{ w }}</span>{{ ' ' }}{% endfor %}</div>
    {% endif %}
    {% if s.text and not has_vis %}<div class="text">{{ s.text }}</div>{% endif %}
    {% if s.type == 'person' %}{% set pic = pictures.get(s.person, {}) %}{% set ref = people.get(s.person, {}) %}
      {% if pic.uri %}
      <div class="vis collage" data-anim="collage">
        <div class="paper" data-part="paper"></div>
        <div class="frame" data-part="frame"><div class="tape" data-part="tape"></div><div class="photo-in"><img src="{{ pic.uri }}" alt=""></div></div>
        <div class="who" data-part="tag"><b>{{ ref.name_ru or s.person }}</b>{% if ref.role_ru %}<span>{{ ref.role_ru }}</span>{% endif %}</div>
        <div class="credit">{{ pic.credit }}</div>
      </div>
      {% else %}
      <div class="namecard" data-anim="ill"><b>{{ ref.name_ru or s.person }}</b>{% if ref.role_ru %}<span>{{ ref.role_ru }}</span>{% endif %}</div>
      {% endif %}
    {% elif ills.get(s.illustration_id) %}
      <div class="vis ill" data-anim="ill"><img src="{{ ills[s.illustration_id] }}" alt=""></div>
    {% endif %}
    </div>
  </div>
  {% endfor %}
  <div id="sub"><span></span></div>
</div>
<script>
const TL = {{ timeline | tojson }};      // [{start, end}] для каждой сцены
const SUBS = {{ subtitles | tojson }};   // [{start, end, text}]
const TOTAL = {{ total }};
const ease = x => 1 - Math.pow(1 - Math.min(Math.max(x, 0), 1), 3);
const scenes = TL.map((_, i) => document.getElementById('sc' + i));
// Счётчик: первая цифра в строке растёт от 0 до значения, остальной текст неизменен.
const counters = [...document.querySelectorAll('[data-count]')].map(el => {
  const raw = el.dataset.count, m = raw.match(/\d[\d\s ]*(?:[.,]\d+)?/);
  if (!m) return null;
  const numStr = m[0].trim(), dec = (numStr.split(/[.,]/)[1] || '').length;
  const value = parseFloat(numStr.replace(/[\s ]/g, '').replace(',', '.'));
  const sep = numStr.includes(',') ? ',' : '.';
  const fmt = v => {
    let s = v.toFixed(dec).replace('.', sep);
    const [i, f] = s.split(sep);
    const g = i.length > 4 ? i.replace(/\B(?=(\d{3})+(?!\d))/g, ' ') : i;
    return f !== undefined ? g + sep + f : g;
  };
  return {el, raw, m: m[0], value, fmt};
}).filter(Boolean);

window.seek = function (t) {
  document.querySelectorAll('.barfill').forEach(b => { b.style.width = (900 * Math.min(t / TOTAL, 1)) + 'px'; });
  document.querySelectorAll('.glow').forEach(g => { g.style.transform = `translate(${-40 * Math.sin(t / 3)}px, ${30 * Math.cos(t / 4)}px)`; });
  TL.forEach((seg, i) => {
    const el = scenes[i], fadeIn = ease((t - seg.start) / 0.16), fadeOut = i === TL.length - 1 ? 1 : 1 - ease((t - seg.end) / 0.12);
    // перекрёстное затухание: уходящая сцена гаснет, пока проявляется следующая
    const vis = t >= seg.start - 0.01 && t < seg.end + 0.13 ? Math.min(fadeIn, fadeOut) : 0;
    el.style.opacity = vis;
    // «наезд» на смене кадра: сцена влетает чуть крупнее и садится на место, потом медленно дышит
    const punch = ease((t - seg.start) / 0.28), drift = Math.min((t - seg.start) / Math.max(seg.end - seg.start, 1), 1);
    el.querySelector('.ct').style.transform = `scale(${1.1 - 0.1 * punch + 0.025 * drift})`;
    const lt = t - seg.start;   // время внутри сцены
    // Заголовок появляется по словам
    el.querySelectorAll('.w').forEach((w, k) => {
      const p = ease((lt - 0.04 * k) / 0.22);
      w.style.opacity = p; w.style.transform = `translateY(${(1 - p) * 40}px)`;
    });
    // Иллюстрация: появление с масштабом и медленный «наезд» камеры
    const ill = el.querySelector('[data-anim="ill"]');
    if (ill) {
      const p = ease((lt - 0.25) / 0.6);
      ill.style.opacity = p;
      ill.style.transform = `translateY(${(1 - p) * 80}px) scale(${0.92 + 0.08 * p}) rotate(${(1 - p) * -3}deg)`;
      ill.firstElementChild.style.transform = `scale(${1.04 + 0.06 * Math.min(lt / Math.max(seg.end - seg.start, 1), 1)}) translateY(${-12 * Math.min(lt / 6, 1)}px)`;
    }
    // Коллаж: подложка, фото «влетает» и ложится под углом, скотч и подпись — с задержкой
    const col = el.querySelector('[data-anim="collage"]');
    if (col) {
      const q = n => col.querySelector(`[data-part="${n}"]`);
      const pp = ease((lt - 0.15) / 0.4), pf = ease((lt - 0.3) / 0.55), ptape = ease((lt - 0.8) / 0.25), ptag = ease((lt - 0.95) / 0.35);
      q('paper').style.transform = `rotate(${5 * pp}deg) scale(${0.8 + 0.2 * pp})`; q('paper').style.opacity = pp;
      q('frame').style.transform = `translateX(${(1 - pf) * 500}px) rotate(${-3 - (1 - pf) * 12}deg)`; q('frame').style.opacity = pf;
      q('tape').style.opacity = ptape; q('tape').style.transform = `rotate(-38deg) scale(${1.3 - 0.3 * ptape})`;
      q('tag').style.opacity = ptag; q('tag').style.transform = `rotate(-2deg) translateY(${(1 - ptag) * 30}px)`;
      col.style.transform = `translateY(${-6 * Math.sin(lt * 1.2)}px)`;
    }
    const c = counters.find(c => el.contains(c.el));
    if (c) {
      const p = ease((t - seg.start - 0.15) / 1.2);
      c.el.textContent = c.raw.replace(c.m, c.fmt(c.value * p) + (c.m.endsWith(' ') ? ' ' : ''));
    }
  });
  const sub = SUBS.find(s => t >= s.start && t < s.end);
  const box = document.getElementById('sub');
  box.classList.toggle('hidden', !sub);
  // субтитры по словам: сказанное — белым, ещё не сказанное — приглушённым (караоке)
  if (sub) box.firstElementChild.innerHTML = (sub.words || [{t: sub.start, w: sub.text}])
    .map(x => `<b class="${t >= x.t ? 'on' : ''}">${x.w.replace(/[&<>]/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;'})[c])}</b>`).join(' ');
};
window.seek(0);
</script>
<script>
// Автоподгонка как у каруселей: уменьшаем заголовок, пока зона контента не перестанет переполняться,
// но не ниже пола шкалы. Не влезло на полу — значит, текст длинный: сообщаем согласующему, а не мельчим.
(function () {
  const FLOOR = {title: 64, stat: 120};
  function wide(el) { return el.scrollWidth > el.clientWidth + 2; }
  function over(ct) {
    const r = ct.getBoundingClientRect();
    for (const c of ct.children) {
      const b = c.getBoundingClientRect();
      if (b.height && (b.bottom > r.bottom + 2 || b.top < r.top - 2)) return true;
    }
    return ct.scrollHeight > ct.clientHeight + 2;
  }
  window.layoutIssues = [];
  window.fitAll = function () {
    document.querySelectorAll('.scene').forEach((sec, idx) => {
      const ct = sec.querySelector('.ct');
      const heads = [...ct.querySelectorAll('.title,.stat')];
      for (let guard = 0; guard < 40 && heads.length; guard++) {
        const w = heads.filter(wide);
        if (!w.length && !over(ct)) break;
        const targets = (w.length ? w : heads).filter(h =>
          parseFloat(getComputedStyle(h).fontSize) * 0.94 >= FLOOR[h.classList.contains('stat') ? 'stat' : 'title']);
        if (!targets.length) break;
        targets.forEach(h => { h.style.fontSize = (parseFloat(getComputedStyle(h).fontSize) * 0.94) + 'px'; });
      }
      if (heads.some(wide) || over(ct)) window.layoutIssues.push('сцена ' + (idx + 1) + ': текст не помещается');
    });
  };
})();
</script>
<script>
document.fonts.ready.then(() => {
  document.querySelectorAll('.scene').forEach(s => { s.style.opacity = 1; s.querySelector('.ct').style.transform = 'none'; });
  document.querySelectorAll('.w').forEach(w => { w.style.transform = 'none'; });
  document.querySelectorAll('[data-anim], [data-part]').forEach(x => { x.style.transform = 'none'; });
  fitAll();
  window.seek(0);
  document.body.dataset.fitted = '1';
});
</script>
</body></html>
