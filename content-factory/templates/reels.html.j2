<!doctype html>
<html lang="ru"><head><meta charset="utf-8">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&display=swap">
<style>
@font-face{font-family:"TT Firs Neue";src:url("{{ assets }}/TT_Firs_Neue_Trial_Var_Roman.ttf") format("truetype-variations");font-weight:100 900}
:root{--navy:#28348a;--sky:#009fe3;--green:#88c947;--orange:#ff954c;--periwinkle:#556bb8;
--display:"TT Firs Neue","Montserrat",sans-serif;--text:"Montserrat",sans-serif;--accent:var(--{{ accent }})}
*{box-sizing:border-box}html,body{margin:0;width:1080px;height:1920px;overflow:hidden;background:var(--navy);font-family:var(--text)}
#stage{position:relative;width:1080px;height:1920px;overflow:hidden;background:var(--navy);color:#fff}
.glow{position:absolute;width:1100px;height:1100px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--accent) 60%,transparent),transparent 62%)}
#g1{right:-420px;top:-380px}#g2{left:-520px;bottom:-460px;background:radial-gradient(circle,rgba(166,229,236,.28),transparent 62%)}
.top{position:absolute;left:90px;right:90px;top:150px;display:flex;justify-content:space-between;align-items:center;z-index:5}
.logo{height:54px;filter:brightness(0) invert(1)}
.rubric{font-size:24px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.8)}
#bar{position:absolute;left:90px;right:90px;top:240px;height:6px;border-radius:3px;background:rgba(255,255,255,.18);z-index:5}
#bar i{display:block;height:100%;width:0;border-radius:3px;background:#fff}
.scene{position:absolute;left:90px;right:90px;top:310px;bottom:540px;display:flex;flex-direction:column;justify-content:center;opacity:0}
.scene.accent-bg{left:0;right:0;top:0;bottom:0;padding:310px 90px 540px;background:var(--accent)}
.eyebrow{display:inline-block;align-self:flex-start;font-size:26px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;padding:12px 24px;border-radius:999px;background:var(--accent);color:#fff;margin-bottom:34px}
.accent-bg .eyebrow{background:rgba(255,255,255,.22)}
.title{font-family:var(--display);font-weight:800;letter-spacing:-.02em;line-height:1.0}
.text{font-size:40px;font-weight:600;line-height:1.35;margin-top:36px;opacity:.9;max-width:22ch}
.stat{font-family:var(--display);font-weight:800;letter-spacing:-.03em;line-height:.9}
#sub{position:absolute;left:70px;right:70px;top:1450px;text-align:center;z-index:6}
#sub span{display:inline;font-size:44px;font-weight:700;line-height:1.5;color:#fff;background:rgba(12,20,70,.72);padding:6px 18px;border-radius:14px;-webkit-box-decoration-break:clone;box-decoration-break:clone}
#sub.hidden{display:none}
.w{display:inline-block;will-change:transform,opacity}
.vis{position:relative;margin-top:44px;align-self:center}
.ill{width:700px;height:700px;border-radius:40px;overflow:hidden;border:10px solid #fff;box-shadow:0 30px 70px rgba(0,0,0,.35)}
.ill img{width:100%;height:100%;object-fit:cover;display:block;transform-origin:50% 60%}
.collage{width:640px;height:700px}
.collage .paper{position:absolute;inset:0;background:var(--accent);border-radius:6px}
.collage .frame{position:absolute;inset:18px 24px 30px 18px;background:#fff;padding:18px;box-shadow:0 22px 50px rgba(0,0,0,.35)}
.collage .photo-in{position:relative;width:100%;height:100%;overflow:hidden;background:#ccc}
.collage .photo-in img{width:100%;height:100%;object-fit:cover;object-position:50% 18%;filter:grayscale(1) contrast(1.15) brightness(1.05);display:block}
.collage .photo-in::after{content:"";position:absolute;inset:0;background:#7fb8ff;mix-blend-mode:multiply;opacity:.55}
.collage .photo-in::before{content:"";position:absolute;inset:0;z-index:2;opacity:.18;mix-blend-mode:multiply;background-image:radial-gradient(#000 1.3px,transparent 1.7px);background-size:8px 8px}
.collage .tape{position:absolute;width:210px;height:54px;background:rgba(255,246,214,.85);top:8px;left:-44px;z-index:3}
.collage .tag{position:absolute;left:-30px;bottom:-30px;z-index:4;background:#fff;color:var(--navy);padding:20px 28px;border-radius:16px;max-width:600px}
.collage .tag b{display:block;font-family:var(--display);font-size:42px;line-height:1.05}
.collage .tag span{font-size:24px;font-weight:700;opacity:.75}
.collage .mono{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-family:var(--display);font-size:260px;font-weight:800;color:#fff;background:var(--navy)}
.credit{position:absolute;left:0;right:0;bottom:-90px;font-size:18px;opacity:.6;text-align:center}
</style></head><body>
<div id="stage">
  <div class="glow" id="g1"></div><div class="glow" id="g2"></div>
  {% for s in scenes %}
  <div class="scene{% if s.type in ('stat', 'insight') %} accent-bg{% endif %}" id="sc{{ loop.index0 }}">
    {% if s.eyebrow %}<span class="eyebrow">{{ s.eyebrow }}</span>{% endif %}
    {% set has_vis = (s.type == 'person') or ills.get(s.illustration_id) %}
    {% if s.type == 'stat' %}
      <div class="stat" data-count="{{ s.title }}" style="font-size:{{ 300 if s.title|length < 7 else (210 if s.title|length < 11 else 150) }}px">{{ s.title }}</div>
    {% else %}
      <div class="title" style="font-size:{{ (80 if s.title|length < 30 else 66) if has_vis else (112 if s.title|length < 24 else (94 if s.title|length < 40 else 80)) }}px">{% for w in s.title.split(' ') %}<span class="w">{{ w }}</span>{{ ' ' }}{% endfor %}</div>
    {% endif %}
    {% if s.text and not has_vis %}<div class="text">{{ s.text }}</div>{% endif %}
    {% if s.type == 'person' %}{% set pic = pictures.get(s.person, {}) %}{% set ref = people.get(s.person, {}) %}
      <div class="vis collage" data-anim="collage">
        <div class="paper" data-part="paper"></div>
        <div class="frame" data-part="frame"><div class="tape" data-part="tape"></div><div class="photo-in">
          {% if pic.uri %}<img src="{{ pic.uri }}" alt="">{% else %}<div class="mono">{{ (ref.name_ru or s.person or '?')[:1] }}</div>{% endif %}
        </div></div>
        <div class="tag" data-part="tag"><b>{{ ref.name_ru or s.person }}</b>{% if ref.role_ru %}<span>{{ ref.role_ru }}</span>{% endif %}</div>
        {% if pic.credit %}<div class="credit">{{ pic.credit }}</div>{% endif %}
      </div>
    {% elif ills.get(s.illustration_id) %}
      <div class="vis ill" data-anim="ill"><img src="{{ ills[s.illustration_id] }}" alt=""></div>
    {% endif %}
  </div>
  {% endfor %}
  <div class="top"><img class="logo" src="{{ assets }}/logo-horizontal.png" alt=""><span class="rubric">{{ rubric_title }}</span></div>
  <div id="bar"><i></i></div>
  <div id="sub"><span></span></div>
</div>
<script>
const TL = {{ timeline | tojson }};      // [{start, end}] для каждой сцены
const SUBS = {{ subtitles | tojson }};   // [{start, end, text}]
const TOTAL = {{ total }};
const ease = x => 1 - Math.pow(1 - Math.min(Math.max(x, 0), 1), 3);
const scenes = TL.map((_, i) => document.getElementById('sc' + i));
// Счётчик: первая цифра в строке растёт от 0 до значения, остальной текст неизменен.
const counters = [...document.querySelectorAll('[data-count]')].map(el => {
  const raw = el.dataset.count, m = raw.match(/\d[\d\s ]*(?:[.,]\d+)?/);
  if (!m) return null;
  const numStr = m[0].trim(), dec = (numStr.split(/[.,]/)[1] || '').length;
  const value = parseFloat(numStr.replace(/[\s ]/g, '').replace(',', '.'));
  const sep = numStr.includes(',') ? ',' : '.';
  const fmt = v => {
    let s = v.toFixed(dec).replace('.', sep);
    const [i, f] = s.split(sep);
    const g = i.length > 4 ? i.replace(/\B(?=(\d{3})+(?!\d))/g, ' ') : i;
    return f !== undefined ? g + sep + f : g;
  };
  return {el, raw, m: m[0], value, fmt};
}).filter(Boolean);

window.seek = function (t) {
  document.getElementById('bar').firstElementChild.style.width = (100 * Math.min(t / TOTAL, 1)) + '%';
  document.getElementById('g1').style.transform = `translate(${-40 * Math.sin(t / 3)}px, ${30 * Math.cos(t / 4)}px)`;
  document.getElementById('g2').style.transform = `translate(${30 * Math.cos(t / 5)}px, ${-30 * Math.sin(t / 3)}px)`;
  TL.forEach((seg, i) => {
    const el = scenes[i], fadeIn = ease((t - seg.start) / 0.3), fadeOut = i === TL.length - 1 ? 1 : 1 - ease((t - seg.end) / 0.25);
    // перекрёстное затухание: уходящая сцена гаснет, пока проявляется следующая
    const vis = t >= seg.start - 0.01 && t < seg.end + 0.26 ? Math.min(fadeIn, fadeOut) : 0;
    el.style.opacity = vis;
    el.style.transform = `translateY(${(1 - fadeIn) * 60}px)`;
    const lt = t - seg.start;   // время внутри сцены
    // Заголовок появляется по словам
    el.querySelectorAll('.w').forEach((w, k) => {
      const p = ease((lt - 0.06 * k) / 0.35);
      w.style.opacity = p; w.style.transform = `translateY(${(1 - p) * 40}px)`;
    });
    // Иллюстрация: появление с масштабом и медленный «наезд» камеры
    const ill = el.querySelector('[data-anim="ill"]');
    if (ill) {
      const p = ease((lt - 0.25) / 0.6);
      ill.style.opacity = p;
      ill.style.transform = `translateY(${(1 - p) * 80}px) scale(${0.92 + 0.08 * p}) rotate(${(1 - p) * -3}deg)`;
      ill.firstElementChild.style.transform = `scale(${1.04 + 0.06 * Math.min(lt / Math.max(seg.end - seg.start, 1), 1)}) translateY(${-12 * Math.min(lt / 6, 1)}px)`;
    }
    // Коллаж: подложка, фото «влетает» и ложится под углом, скотч и подпись — с задержкой
    const col = el.querySelector('[data-anim="collage"]');
    if (col) {
      const q = n => col.querySelector(`[data-part="${n}"]`);
      const pp = ease((lt - 0.15) / 0.4), pf = ease((lt - 0.3) / 0.55), ptape = ease((lt - 0.8) / 0.25), ptag = ease((lt - 0.95) / 0.35);
      q('paper').style.transform = `rotate(${5 * pp}deg) scale(${0.8 + 0.2 * pp})`; q('paper').style.opacity = pp;
      q('frame').style.transform = `translateX(${(1 - pf) * 500}px) rotate(${-3 - (1 - pf) * 12}deg)`; q('frame').style.opacity = pf;
      q('tape').style.opacity = ptape; q('tape').style.transform = `rotate(-38deg) scale(${1.3 - 0.3 * ptape})`;
      q('tag').style.opacity = ptag; q('tag').style.transform = `rotate(-2deg) translateY(${(1 - ptag) * 30}px)`;
      col.style.transform = `translateY(${-6 * Math.sin(lt * 1.2)}px)`;
    }
    const c = counters.find(c => el.contains(c.el));
    if (c) {
      const p = ease((t - seg.start - 0.15) / 1.2);
      c.el.textContent = c.raw.replace(c.m, c.fmt(c.value * p) + (c.m.endsWith(' ') ? ' ' : ''));
    }
  });
  const sub = SUBS.find(s => t >= s.start && t < s.end);
  const box = document.getElementById('sub');
  box.classList.toggle('hidden', !sub);
  if (sub) box.firstElementChild.textContent = sub.text;
};
window.seek(0);
</script>
<script>
// Автоподгонка: уменьшаем заголовки, пока они не влезут по ширине (длинные слова) и слайд не перестанет переполняться.
(function () {
  function wide(el) { return el.scrollWidth > el.clientWidth + 2; }
  function over(sec) {
    const r = sec.getBoundingClientRect(), cs = getComputedStyle(sec);
    const top = r.top + parseFloat(cs.paddingTop) - 2, bottom = r.bottom - parseFloat(cs.paddingBottom) + 2;
    for (const c of sec.children) {
      if (getComputedStyle(c).position === 'absolute') continue;
      const b = c.getBoundingClientRect();
      if (b.height && (b.bottom > bottom || b.top < top)) return true;
    }
    return false;
  }
  window.fitAll = function (selector) {
    document.querySelectorAll(selector).forEach(sec => {
      const heads = [...sec.querySelectorAll('h1,h2,.big,.title,.stat')];
      for (let guard = 0; guard < 40 && heads.length; guard++) {
        const w = heads.filter(wide);
        if (!w.length && !over(sec)) break;
        (w.length ? w : heads).forEach(h => {
          h.style.fontSize = (parseFloat(getComputedStyle(h).fontSize) * 0.93) + 'px';
        });
      }
    });
  };
})();
</script>
<script>
document.fonts.ready.then(() => {
  document.querySelectorAll('.scene').forEach(s => { s.dataset.op = s.style.opacity; s.style.opacity = 1; s.style.transform = 'none'; });
  document.querySelectorAll('.w').forEach(w => { w.style.transform = 'none'; });
  document.querySelectorAll('[data-anim], [data-part]').forEach(x => { x.style.transform = 'none'; });
  fitAll('.scene');
  window.seek(0);
  document.body.dataset.fitted = '1';
});
</script>
</body></html>
