<!doctype html>
<html lang="ru"><head><meta charset="utf-8">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&display=swap">
<style>
@font-face{font-family:"TT Firs Neue";src:url("{{ assets }}/TT_Firs_Neue_Trial_Var_Roman.ttf") format("truetype-variations");font-weight:100 900}
:root{--navy:#28348a;--sky:#009fe3;--green:#88c947;--orange:#ff954c;--periwinkle:#556bb8;
--display:"TT Firs Neue","Montserrat",sans-serif;--text:"Montserrat",sans-serif;--accent:var(--{{ accent }})}
*{box-sizing:border-box}html,body{margin:0;width:1080px;height:1920px;overflow:hidden;background:var(--navy);font-family:var(--text)}
#stage{position:relative;width:1080px;height:1920px;overflow:hidden;background:var(--navy);color:#fff}
.glow{position:absolute;width:1100px;height:1100px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--accent) 60%,transparent),transparent 62%)}
#g1{right:-420px;top:-380px}#g2{left:-520px;bottom:-460px;background:radial-gradient(circle,rgba(166,229,236,.28),transparent 62%)}
.top{position:absolute;left:90px;right:90px;top:150px;display:flex;justify-content:space-between;align-items:center;z-index:5}
.logo{height:54px;filter:brightness(0) invert(1)}
.rubric{font-size:24px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.8)}
#bar{position:absolute;left:90px;right:90px;top:240px;height:6px;border-radius:3px;background:rgba(255,255,255,.18);z-index:5}
#bar i{display:block;height:100%;width:0;border-radius:3px;background:#fff}
.scene{position:absolute;left:90px;right:90px;top:330px;bottom:560px;display:flex;flex-direction:column;justify-content:center;opacity:0}
.scene.accent-bg{left:0;right:0;top:0;bottom:0;padding:330px 90px 560px;background:var(--accent)}
.eyebrow{display:inline-block;align-self:flex-start;font-size:26px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;padding:12px 24px;border-radius:999px;background:var(--accent);color:#fff;margin-bottom:34px}
.accent-bg .eyebrow{background:rgba(255,255,255,.22)}
.title{font-family:var(--display);font-weight:800;letter-spacing:-.02em;line-height:1.0}
.text{font-size:40px;font-weight:600;line-height:1.35;margin-top:36px;opacity:.9;max-width:22ch}
.stat{font-family:var(--display);font-weight:800;letter-spacing:-.03em;line-height:.9}
#sub{position:absolute;left:70px;right:70px;top:1400px;text-align:center;z-index:6}
#sub span{display:inline;font-size:44px;font-weight:700;line-height:1.5;color:#fff;background:rgba(12,20,70,.72);padding:6px 18px;border-radius:14px;-webkit-box-decoration-break:clone;box-decoration-break:clone}
#sub.hidden{display:none}
</style></head><body>
<div id="stage">
  <div class="glow" id="g1"></div><div class="glow" id="g2"></div>
  {% for s in scenes %}
  <div class="scene{% if s.type in ('stat', 'insight') %} accent-bg{% endif %}" id="sc{{ loop.index0 }}">
    {% if s.eyebrow %}<span class="eyebrow">{{ s.eyebrow }}</span>{% endif %}
    {% if s.type == 'stat' %}
      <div class="stat" data-count="{{ s.title }}" style="font-size:{{ 300 if s.title|length < 7 else (210 if s.title|length < 11 else 150) }}px">{{ s.title }}</div>
    {% else %}
      <div class="title" style="font-size:{{ 112 if s.title|length < 24 else (94 if s.title|length < 40 else 80) }}px">{{ s.title }}</div>
    {% endif %}
    {% if s.text %}<div class="text">{{ s.text }}</div>{% endif %}
  </div>
  {% endfor %}
  <div class="top"><img class="logo" src="{{ assets }}/logo-horizontal.png" alt=""><span class="rubric">{{ rubric_title }}</span></div>
  <div id="bar"><i></i></div>
  <div id="sub"><span></span></div>
</div>
<script>
const TL = {{ timeline | tojson }};      // [{start, end}] для каждой сцены
const SUBS = {{ subtitles | tojson }};   // [{start, end, text}]
const TOTAL = {{ total }};
const ease = x => 1 - Math.pow(1 - Math.min(Math.max(x, 0), 1), 3);
const scenes = TL.map((_, i) => document.getElementById('sc' + i));
// Счётчик: первая цифра в строке растёт от 0 до значения, остальной текст неизменен.
const counters = [...document.querySelectorAll('[data-count]')].map(el => {
  const raw = el.dataset.count, m = raw.match(/\d[\d\s ]*(?:[.,]\d+)?/);
  if (!m) return null;
  const numStr = m[0].trim(), dec = (numStr.split(/[.,]/)[1] || '').length;
  const value = parseFloat(numStr.replace(/[\s ]/g, '').replace(',', '.'));
  const sep = numStr.includes(',') ? ',' : '.';
  const fmt = v => {
    let s = v.toFixed(dec).replace('.', sep);
    const [i, f] = s.split(sep);
    const g = i.length > 4 ? i.replace(/\B(?=(\d{3})+(?!\d))/g, ' ') : i;
    return f !== undefined ? g + sep + f : g;
  };
  return {el, raw, m: m[0], value, fmt};
}).filter(Boolean);

window.seek = function (t) {
  document.getElementById('bar').firstElementChild.style.width = (100 * Math.min(t / TOTAL, 1)) + '%';
  document.getElementById('g1').style.transform = `translate(${-40 * Math.sin(t / 3)}px, ${30 * Math.cos(t / 4)}px)`;
  document.getElementById('g2').style.transform = `translate(${30 * Math.cos(t / 5)}px, ${-30 * Math.sin(t / 3)}px)`;
  TL.forEach((seg, i) => {
    const el = scenes[i], fadeIn = ease((t - seg.start) / 0.3), fadeOut = i === TL.length - 1 ? 1 : 1 - ease((t - seg.end + 0.25) / 0.25);
    const vis = t >= seg.start - 0.01 && t < seg.end + 0.01 ? Math.min(fadeIn, fadeOut) : 0;
    el.style.opacity = vis;
    el.style.transform = `translateY(${(1 - fadeIn) * 60}px)`;
    const c = counters.find(c => el.contains(c.el));
    if (c) {
      const p = ease((t - seg.start - 0.15) / 1.2);
      c.el.textContent = c.raw.replace(c.m, c.fmt(c.value * p) + (c.m.endsWith(' ') ? ' ' : ''));
    }
  });
  const sub = SUBS.find(s => t >= s.start && t < s.end);
  const box = document.getElementById('sub');
  box.classList.toggle('hidden', !sub);
  if (sub) box.firstElementChild.textContent = sub.text;
};
window.seek(0);
</script>
</body></html>
