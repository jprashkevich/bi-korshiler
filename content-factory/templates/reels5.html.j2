<!doctype html>
<html lang="ru"><head><meta charset="utf-8">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=Caveat:wght@600;700&display=swap">
<style>
@font-face{font-family:"TT Firs Neue";src:url("{{ assets }}/TT_Firs_Neue_Trial_Var_Roman.ttf") format("truetype-variations");font-weight:100 900}
/* Формат 5 (config/reels-motion.md, разбор tillo 28.11): монтаж идёт за голосом.
   Хук — картинка на весь кадр и крупный текст; затем вспышка, и кадр делится: сверху окно перебивок
   (меняются на названном слове, жёсткий рез), снизу метафора-якорь — она вместо ведущего держит
   внимание весь ролик и в финале раскрывается на весь кадр. Зоны Instagram: 0–140 и 1600–1920. */
:root{--navy:#28348a;--sky:#009fe3;--green:#88c947;--orange:#ff954c;--periwinkle:#556bb8;--cream:#f6efe4;--ink:#2b3350;
--accent:var(--{{ accent }});--accent2:var(--{{ accent2 }});
--display:"TT Firs Neue","Montserrat",sans-serif}
*{box-sizing:border-box}html,body{margin:0;width:1080px;height:1920px;overflow:hidden;background:var(--cream);font-family:Montserrat,sans-serif}
#stage{position:relative;width:1080px;height:1920px;overflow:hidden;background:var(--cream);color:var(--navy)}
.grain{position:absolute;inset:0;z-index:40;pointer-events:none;opacity:.18;mix-blend-mode:multiply;
 background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/><feColorMatrix values='0 0 0 0 0.4 0 0 0 0 0.35 0 0 0 0 0.3 0 0 0 .55 0'/></filter><rect width='220' height='220' filter='url(%23n)'/></svg>")}
#logo{position:absolute;left:50%;top:142px;transform:translateX(-50%);height:38px;z-index:35;background:var(--cream);padding:10px 18px;border-radius:999px;box-sizing:content-box}
/* окно перебивок */
#win{position:absolute;overflow:hidden;z-index:10;background:#1c2036}
.cut{position:absolute;inset:0;opacity:0;overflow:hidden}
.cut.paper{background:#fbf6ee}
.cut .bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.92)}
.cut .shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,24,60,.45) 0,rgba(20,24,60,0) 28%,rgba(20,24,60,0) 70%,rgba(20,24,60,.3) 100%)}
.inner{position:absolute;left:50%;top:50%;width:1080px;height:1000px;display:flex;flex-direction:column;align-items:center;justify-content:center;transform-origin:50% 50%}
.pcard{position:relative;background:#fff;padding:18px;box-shadow:0 18px 40px rgba(60,40,20,.2)}
.pcard img{display:block;width:100%;height:100%;object-fit:cover}
.pcard.ill img{object-fit:contain}
.pcard.bw img{object-position:50% 18%;filter:grayscale(1) contrast(1.1)}
.tape{position:absolute;width:160px;height:44px;background:rgba(255,244,210,.9);top:-20px;left:50%;margin-left:-80px;transform:rotate(-4deg)}
.cap{margin-top:40px;max-width:920px;text-align:center;font-family:var(--display);font-weight:800;font-size:66px;line-height:1.02;color:var(--navy)}
.cap small{display:block;font-family:Montserrat;font-weight:700;font-size:34px;line-height:1.3;color:var(--ink);opacity:.75;margin-top:14px}
.map svg{width:940px;height:731px}
.map .hit{transform-box:fill-box;transform-origin:center}
.tagname{display:inline-block;margin-top:30px;background:var(--accent);color:#fff;font-weight:800;font-size:34px;padding:10px 22px;border-radius:14px}
.tagrole{display:inline-block;margin-top:12px;background:#fff;color:var(--navy);font-weight:700;font-size:28px;padding:8px 18px;border-radius:12px;box-shadow:0 4px 12px rgba(0,0,0,.08)}
.jcover{width:620px;height:840px;background:var(--navy);color:#fff;padding:46px 44px;position:relative;box-shadow:0 22px 50px rgba(20,20,60,.3);display:flex;flex-direction:column}
.jcover .mast{font-family:var(--display);font-weight:800;font-size:84px;line-height:.92;letter-spacing:-.02em;border-bottom:4px solid rgba(255,255,255,.85);padding-bottom:24px}
.jcover .kick{margin-top:26px;font-weight:800;font-size:26px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
.jcover .head{margin-top:auto;font-family:var(--display);font-weight:700;font-size:52px;line-height:1.08}
.jcover .bar{position:absolute;right:44px;top:46px;width:70px;height:70px;border-radius:50%;background:var(--accent)}
.article{width:860px;height:960px;overflow:hidden;padding:0}
.article img{width:100%;height:auto;object-fit:initial}
.segnum{font-family:var(--display);font-weight:800;color:var(--navy);letter-spacing:-.03em;line-height:.9;font-size:300px}
.segquote{max-width:900px;font-family:var(--display);font-weight:700;font-size:74px;line-height:1.12;color:var(--navy)}
.segquote:before{content:"«";display:block;font-size:200px;line-height:.6;color:var(--accent)}
#circle{position:absolute;z-index:12;pointer-events:none;overflow:visible}
#circle path{stroke-dasharray:100;stroke-dashoffset:100}
#src{position:absolute;z-index:13;font-weight:700;font-size:22px;color:#fff;background:rgba(28,32,54,.55);padding:6px 14px;border-radius:999px;opacity:0;white-space:nowrap}
/* якорь-метафора */
#anchor{position:absolute;left:40px;top:600px;width:1000px;height:1000px;z-index:5;transform-origin:50% 50%;opacity:0}
#anchor canvas{width:100%;height:100%}
/* хук, субтитры, вспышка */
#hook{position:absolute;left:80px;right:80px;top:290px;z-index:30;font-family:var(--display);font-weight:800;font-size:112px;line-height:.98;letter-spacing:-.02em;opacity:0;color:var(--navy)}
#hook.on-photo{color:#fff;text-shadow:0 6px 30px rgba(10,14,50,.45)}
#hook .hl{color:var(--accent)}
#sub{position:absolute;left:70px;right:70px;top:1390px;z-index:31;text-align:center}
#sub span{display:inline;font-size:50px;font-weight:700;line-height:1.5;color:var(--navy);background:#fff;padding:6px 20px;border-radius:16px;
  box-shadow:0 6px 18px rgba(40,52,138,.12);-webkit-box-decoration-break:clone;box-decoration-break:clone}
#sub b{font-weight:900;border-radius:8px;padding:0 6px;background:linear-gradient(color-mix(in srgb,var(--accent) 55%,#fff),color-mix(in srgb,var(--accent) 55%,#fff)) no-repeat 0 85%/0% 40%}
#sub.hidden{display:none}
#flash{position:absolute;inset:0;z-index:38;background:#fff;opacity:0;pointer-events:none}
#endtag{position:absolute;left:50%;transform:translateX(-50%);top:1540px;z-index:31;font-weight:800;font-size:28px;color:var(--navy);opacity:0;
  background:#fff;padding:12px 26px;border-radius:999px;white-space:nowrap;box-shadow:0 6px 18px rgba(40,52,138,.12)}
</style></head><body>
<div id="stage">
  <img id="logo" src="{{ assets }}/logo-horizontal.png" alt="BIG Life">
  <div id="anchor" class="scene" style="color:var(--navy)"><canvas></canvas></div>
  <div id="win">
    {% for g in cuts %}
    <div class="cut {{ 'full' if g.type == 'full' else 'paper' }}{% if g.type == 'map' %} map{% endif %}" id="cut{{ loop.index0 }}">
      {% if g.type == 'full' %}
        {% if g.uri.endswith('.webm') or g.uri.endswith('.mp4') %}<video class="bg vid" src="{{ g.uri }}" muted preload="auto" playsinline></video>{% else %}<img class="bg" src="{{ g.uri }}" alt="">{% endif %}<div class="shade"></div>
      {% else %}<div class="inner">
        {% if g.type == 'card' %}<div class="pcard ill" style="width:820px;height:820px"><img src="{{ g.uri }}" alt=""><div class="tape"></div></div>
        {% elif g.type == 'map' %}{{ g.svg | safe }}
        {% elif g.type == 'person' %}<div class="pcard bw" style="width:560px;height:680px"><img src="{{ g.uri }}" alt=""><div class="tape"></div></div><span class="tagname">{{ g.name }}</span>{% if g.role %}<span class="tagrole">{{ g.role }}</span>{% endif %}
        {% elif g.type == 'namecard' %}<div class="cap" style="font-size:100px">{{ g.name }}{% if g.role %}<small>{{ g.role }}</small>{% endif %}</div>
        {% elif g.type == 'journal' %}<div class="jcover"><span class="bar"></span><div class="mast">{{ g.name }}</div><div class="kick">{{ g.detail or 'исследование' }}</div><div class="head">{{ g.caption }}</div></div>
        {% elif g.type == 'article' %}<div class="pcard article"><img src="{{ g.uri }}" alt=""><div class="tape"></div></div>
        {% elif g.type == 'number' %}<div class="segnum" data-count="{{ g.text }}"><span class="v">{{ g.text }}</span></div>
        {% elif g.type == 'quote' %}<div class="segquote">{{ g.text }}</div>
        {% endif %}
        {% if g.caption and g.type not in ('journal', 'namecard', 'article') %}<div class="cap">{{ g.caption }}{% if g.detail and g.type not in ('person',) %}<small>{{ g.detail }}</small>{% endif %}</div>{% endif %}
      </div>{% endif %}
    </div>
    {% endfor %}
  </div>
  <svg id="circle" viewBox="0 0 400 260" preserveAspectRatio="none"><path d="M210 12 C 90 4, 10 50, 18 130 C 28 220, 300 250, 372 160 C 420 90, 340 10, 190 18" fill="none" stroke="var(--accent)" stroke-width="5" stroke-linecap="round" pathLength="100"/></svg>
  {% if source %}<div id="src">{{ source }}</div>{% endif %}
  <div id="hook" style="font-size:{{ 112 if hook.title|length <= 28 else (96 if hook.title|length <= 44 else 84) }}px">{% for w in hook.title.split(' ') %}<span class="w{% if hook.highlight and hook.highlight|lower in w|lower %} hl{% endif %}">{{ w }}</span>{{ ' ' }}{% endfor %}</div>
  <div id="sub"><span></span></div>
  <div id="endtag">BIG Life · соседство в цифрах</div>
  <div id="flash"></div>
  <div class="grain"></div>
</div>
<script>{{ viz_js | safe }}</script>
<script>
const SUBS = {{ subtitles | tojson }};
const CUTS = {{ cuts_js | tojson }};       // [{type, start, text}]
const ANCHOR = {{ anchor_js | tojson }};   // [{t, viz}]
const ACCENTS = {{ accents_js | tojson }}; // [{t, motion}]
const HOOK_END = {{ hook_end }}, EXPAND = {{ expand_t }}, TOTAL = {{ total }};
const FLASHES = [HOOK_END].concat(ACCENTS.filter(a => a.motion === 'flash').map(a => a.t));
const ease = x => 1 - Math.pow(1 - Math.min(Math.max(x, 0), 1), 3);
const inout = x => { x = Math.min(Math.max(x, 0), 1); return x < .5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2; };
const esc = s => s.replace(/[&<>]/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;'})[c]);
// геометрия окна: хук — весь кадр; история — окно сверху; финал — окно уходит, метафора на весь кадр
const FULL = {x: 0, y: 0, w: 1080, h: 1920, r: 0}, WIN = {x: 40, y: 150, w: 1000, h: 700, r: 30};

function winRect(t) {
  if (t < HOOK_END) return FULL;
  return WIN;                                   // смена формы спрятана под вспышкой — жёсткий переход
}

window.seek = function (t) {
  const waits = [];
  // --- окно и перебивки ---
  const win = document.getElementById('win'), R = winRect(t);
  const out = t >= EXPAND ? inout((t - EXPAND) / 0.6) : 0;
  Object.assign(win.style, {left: R.x + 'px', top: R.y + 'px', width: R.w + 'px', height: R.h + 'px', borderRadius: R.r + 'px',
                            opacity: 1 - out, transform: `scale(${1 - 0.06 * out})`});
  let cur = -1; CUTS.forEach((c, k) => { if (t >= c.start) cur = k; });
  let onPhoto = false;
  CUTS.forEach((c, k) => {
    const el = document.getElementById('cut' + k);
    const on = k === cur;
    el.style.opacity = on ? 1 : 0;              // жёсткий рез, как у tillo
    if (!on) return;
    const lt = t - c.start, dur = (CUTS[k + 1] ? CUTS[k + 1].start : TOTAL) - c.start;
    // толчок на акцентном слове внутри этой перебивки
    let punch = 0;
    ACCENTS.forEach(a => { if (a.motion === 'punch' && t >= a.t && a.t >= c.start) punch = Math.max(punch, 1 - ease((t - a.t) / 0.25)); });
    if (c.type === 'full') {
      onPhoto = true;
      const m = el.querySelector('.bg');
      // почти незаметный дрейф 3%: статичное фото в вертикали выглядит как слайд-шоу
      m.style.transform = `scale(${1.04 + 0.03 * (lt / Math.max(dur, 1)) + 0.18 * punch})`;
      if (m.tagName === 'VIDEO' && m.duration) {
        const want = Math.min(lt, m.duration - 0.05);
        if (Math.abs(m.currentTime - want) > 0.001) {
          waits.push(new Promise(res => m.addEventListener('seeked', res, {once: true})));
          m.currentTime = want;
        }
      }
    } else {
      const inner = el.querySelector('.inner');
      const k0 = Math.min(R.w / 1080, R.h / 1000) * 0.94;
      const drop = ease(lt / 0.3);              // карточка «падает» на стол
      inner.style.transform = `translate(-50%, -50%) translateY(${(1 - drop) * -40}px) scale(${k0 * (1.08 - 0.08 * drop) * (1 + 0.12 * punch)}) rotate(${(k % 2 ? -1 : 1) * 1.5 * (1 - drop)}deg)`;
      const svg = el.querySelector('.map svg');
      if (svg) {                                // карта: соседи проявляются, страна заливается
        const g = svg.querySelector('g'); if (g) g.style.opacity = ease(lt / 0.4);
        svg.querySelector('.hit').style.transform = `scale(${0.8 + 0.2 * ease((lt - 0.15) / 0.45)})`;
        svg.querySelector('.hit').style.opacity = ease((lt - 0.1) / 0.3);
      }
      const num = el.querySelector('.segnum');
      if (num) {                                // счётчик: цифра набегает от нуля
        const raw = num.dataset.count, mm = raw.match(/\d[\d\s ]*(?:[.,]\d+)?/);
        if (mm) { const val = parseFloat(mm[0].replace(/[\s ]/g, '').replace(',', '.')), dec = (mm[0].split(/[.,]/)[1] || '').length;
          let v = (val * ease(lt / 0.9)).toFixed(dec).replace('.', ',');
          if (v.length > 4) v = v.replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
          num.querySelector('.v').textContent = raw.replace(mm[0], v); }
      }
    }
  });
  // --- рукописная обводка в окне ---
  const circ = document.getElementById('circle');
  const ca = ACCENTS.filter(a => a.motion === 'circle' && t >= a.t && cur >= 0 && a.t >= CUTS[cur].start).pop();
  Object.assign(circ.style, {left: (R.x + R.w * 0.18) + 'px', top: (R.y + R.h * 0.22) + 'px', width: (R.w * 0.64) + 'px', height: (R.h * 0.56) + 'px'});
  circ.style.opacity = ca && t < EXPAND ? 1 : 0;
  circ.firstElementChild.style.strokeDashoffset = ca ? 100 * (1 - ease((t - ca.t) / 0.6)) : 100;
  // --- строка источника в углу окна ---
  const src = document.getElementById('src');
  if (src) { Object.assign(src.style, {left: (R.x + 24) + 'px', top: (R.y + R.h - 56) + 'px'});
    src.style.opacity = t >= HOOK_END && t < EXPAND ? 0.95 : 0; }
  // --- якорь-метафора ---
  const an = document.getElementById('anchor');
  let si = -1; ANCHOR.forEach((a, k) => { if (t >= a.t) si = k; });
  if (si >= 0 && t >= HOOK_END) {
    const st = ANCHOR[si], prev = si > 0 ? ANCHOR[si - 1].viz : null;
    window.drawViz(an.querySelector('canvas'), st.viz, prev && prev.kind === st.viz.kind ? prev : null, t - st.t);
    const sc = 0.5 + 0.5 * out, dy = -340 * out;           // финал: метафора раскрывается на весь кадр
    let dp = 0; ACCENTS.forEach(a => { if (a.motion === 'punch' && t >= a.t) dp = Math.max(dp, 1 - ease((t - a.t) / 0.3)); });
    an.style.transform = `translateY(${dy}px) scale(${sc * (1 + 0.04 * dp)})`;
    an.style.opacity = 1;
  } else an.style.opacity = 0;
  // --- хук ---
  const hk = document.getElementById('hook');
  hk.classList.toggle('on-photo', onPhoto);
  hk.style.opacity = Math.min(ease(t / 0.25), 1 - ease((t - HOOK_END + 0.1) / 0.2));
  hk.querySelectorAll('.w').forEach((w, k) => { const p = ease((t - 0.03 * k) / 0.2); w.style.opacity = p; w.style.transform = `translateY(${(1 - p) * 30}px)`; });
  // --- субтитры: плашка на фразу, маркер под ключевым словом ---
  const sub = SUBS.find(s => t >= s.start && t < s.end), box = document.getElementById('sub');
  box.classList.toggle('hidden', !sub || t < HOOK_END - 0.05);
  if (sub) {
    const hl = (sub.hl || '').toLowerCase();
    const mk = ACCENTS.find(a => a.motion === 'marker' && a.t >= sub.start - 0.05 && a.t < sub.end);
    box.firstElementChild.innerHTML = sub.text.split(' ').map(w => {
      const bare = w.toLowerCase().replace(/[.,!?:;«»"]/g, '');
      const isHl = (hl && bare.startsWith(hl.slice(0, Math.max(4, hl.length - 2)))) || /\d/.test(w);
      return isHl ? `<b>${esc(w)}</b>` : esc(w);
    }).join(' ');
    const p = mk ? ease((t - mk.t) / 0.45) : 0;
    box.querySelectorAll('b').forEach(b => { b.style.backgroundSize = `${100 * p}% 40%`; });
  }
  // --- вспышки ---
  let fl = 0; FLASHES.forEach(f => { if (t >= f - 0.05 && t < f + 0.3) fl = Math.max(fl, t < f ? 1 - (f - t) / 0.05 : 1 - ease((t - f) / 0.3)); });
  document.getElementById('flash').style.opacity = 0.9 * fl;
  document.getElementById('endtag').style.opacity = ease((t - (TOTAL - 2.2)) / 0.4);
  return waits.length ? Promise.all(waits) : null;
};
Promise.all([...[...document.images].map(i => i.complete ? 0 : new Promise(r => { i.onload = i.onerror = r; })),
             ...[...document.querySelectorAll('video')].map(v => v.readyState >= 2 ? 0 : new Promise(r => { v.onloadeddata = v.onerror = r; }))])
  .then(() => document.fonts.ready).then(() => { window.layoutIssues = []; window.seek(0); document.body.dataset.fitted = '1'; });
</script>
</body></html>
